  <diagram name="Fluxo consolidado" id="flux-cons">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1440" pageHeight="1260" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="k2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="&lt;b style=&quot;font-size:16px&quot;&gt;Modelo de fluxo consolidado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;Papéis no planeamento de viagens, a partir dos fluxos de A0 (agente de balcão) e U0 (viajante organizador)&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="12" width="900" height="44" as="geometry" /></mxCell>
        <mxCell id="k3" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;spacing=14;fontFamily=Helvetica;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#9CA3AF;" value="&lt;b&gt;Inspirador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:10px&quot;&gt;criador de conteúdo, ChatGPT (U0)&lt;/font&gt;&lt;br&gt;· mostra destinos e preços apelativos&lt;br&gt;· sugere roteiros e sítios" vertex="1"><mxGeometry x="400" y="70" width="290" height="120" as="geometry" /></mxCell>
        <mxCell id="k4" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;spacing=14;fontFamily=Helvetica;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#9CA3AF;" value="&lt;b&gt;Guardião financeiro&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:10px&quot;&gt;mãe (U0)&lt;/font&gt;&lt;br&gt;· vigia os gastos&lt;br&gt;· quer saber onde se dorme" vertex="1"><mxGeometry x="40" y="80" width="240" height="110" as="geometry" /></mxCell>
        <mxCell id="k5" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;spacing=14;fontFamily=Helvetica;fontColor=#1F2937;fillColor=#DAE8FC;strokeColor=#6C8EBF;" value="&lt;b&gt;Planeador da viagem&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:10px&quot;&gt;U0 · casal (A0)&lt;/font&gt;&lt;br&gt;· pesquisa e compara voos e alojamento&lt;br&gt;· monta o roteiro e verifica-o&lt;br&gt;· soma o custo total por pessoa&lt;br&gt;· decide e reserva" vertex="1"><mxGeometry x="370" y="290" width="360" height="180" as="geometry" /></mxCell>
        <mxCell id="k6" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;spacing=14;fontFamily=Helvetica;fontColor=#1F2937;fillColor=#FFE6CC;strokeColor=#D79B00;" value="&lt;b&gt;Conselheiro de viagem&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:10px&quot;&gt;A0&lt;/font&gt;&lt;br&gt;· descobre o que o cliente quer&lt;br&gt;· aponta o que é inviável&lt;br&gt;· recomenda com o que sabe dos fornecedores" vertex="1"><mxGeometry x="880" y="230" width="320" height="150" as="geometry" /></mxCell>
        <mxCell id="k7" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;spacing=14;fontFamily=Helvetica;fontColor=#1F2937;fillColor=#FFE6CC;strokeColor=#D79B00;" value="&lt;b&gt;Preparador da proposta&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:10px&quot;&gt;A0&lt;/font&gt;&lt;br&gt;· trata os pedidos pendentes&lt;br&gt;· passa os dados do portal para a proposta&lt;br&gt;· envia a proposta e cobra a taxa" vertex="1"><mxGeometry x="880" y="450" width="320" height="150" as="geometry" /></mxCell>
        <mxCell id="k8" parent="1" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=1.5;fontSize=11;spacing=14;fontFamily=Helvetica;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#9CA3AF;" value="&lt;b&gt;Fornecedor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot; style=&quot;font-size:10px&quot;&gt;hotéis (A0)&lt;/font&gt;&lt;br&gt;· vende e mostra fotos" vertex="1"><mxGeometry x="1240" y="220" width="170" height="100" as="geometry" /></mxCell>
