<mxfile host="drawio" type="device"><diagram name="ArtU0" id="ArtU0"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1822" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Artifact models: U0 (organizador(a) do grupo)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="24.0" as="geometry"/></mxCell><mxCell id="c2" value="Os artefactos que U0 usou para planear a viagem a Cracóvia. Apenas o que consta da entrevista a U0." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="48.0" width="956.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="22.0" y="73.0" width="10.0" height="17.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;color:#9a3200&quot;&gt;Breakdown: onde o artefacto atrapalha o trabalho&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Nome da parte&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#555555&quot;&gt;(observação, apresentação)&lt;/i&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: a intenção que a parte serve&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="75.5" width="604.3" height="12.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i&gt;Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="94.0" width="956.0" height="11.4" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Desenhos, não capturas.&lt;/b&gt; A entrevista não guardou capturas de ecrã (perfil de U0: «sem capturas de ecrã»). A folha de cálculo e o grupo de mensagens são desenhados só com o que a transcrição regista; cores, letra e aspeto do ecrã não foram registados e não se mostram. Nos outros artefactos mostram-se só as partes." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="113.4" width="956.0" height="25.2" as="geometry"/></mxCell><mxCell id="c8" value="Item" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="305.0" y="237.5" width="250.0" height="24.0" as="geometry"/></mxCell><mxCell id="c9" value="€ por pessoa" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555.0" y="237.5" width="140.0" height="24.0" as="geometry"/></mxCell><mxCell id="c10" value="Voo das 11h30" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="305.0" y="261.5" width="250.0" height="24.0" as="geometry"/></mxCell><mxCell id="c11" value="copiado do comparador" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#666666;fontStyle=2;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555.0" y="261.5" width="140.0" height="24.0" as="geometry"/></mxCell><mxCell id="c12" value="Alojamento: quarto privado para 3, 4 noites" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="305.0" y="285.5" width="250.0" height="24.0" as="geometry"/></mxCell><mxCell id="c13" value="24 € × 4 noites" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555.0" y="285.5" width="140.0" height="24.0" as="geometry"/></mxCell><mxCell id="c14" value="Visita à mina de sal" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=8;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="305.0" y="309.5" width="250.0" height="24.0" as="geometry"/></mxCell><mxCell id="c15" value="28 €" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=8;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555.0" y="309.5" width="140.0" height="24.0" as="geometry"/></mxCell><mxCell id="c16" value="Transporte até ao aeroporto (não está na folha)" style="rounded=0;fillColor=#ffffff;strokeColor=#f07a1a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#9a3200;fontStyle=2;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="305.0" y="333.5" width="250.0" height="24.0" as="geometry"/></mxCell><mxCell id="c17" value="—" style="rounded=0;fillColor=#ffffff;strokeColor=#f07a1a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#9a3200;fontStyle=2;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555.0" y="333.5" width="140.0" height="24.0" as="geometry"/></mxCell><mxCell id="c18" value="Total por pessoa" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="305.0" y="357.5" width="250.0" height="26.0" as="geometry"/></mxCell><mxCell id="c19" value="303 € … 294 €" style="rounded=0;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="555.0" y="357.5" width="140.0" height="26.0" as="geometry"/></mxCell><mxCell id="c21" value="Folha de cálculo (duplicada da folha da viagem anterior)" style="rounded=0;fillColor=#f1f1f1;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="267.0" y="208.2" width="466.0" height="21.4" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="267.0" y="229.5" width="466.0" height="154.0" as="geometry"/></mxCell><mxCell id="c23" value="Desenho a partir de UE04, UE05, UE06, UE09 e UE12. Os nomes das colunas não foram registados: descrevem o conteúdo." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#666666;fontStyle=2;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="267.0" y="383.5" width="466.0" height="28.4" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9a9a9a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="207.2" width="468.0" height="205.8" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Folha inteira&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(duplicada da viagem anterior; preços copiados à mão (UE06))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: ver se a viagem cabe nos 300 € por pessoa&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="189.7" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Colunas da viagem anterior&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«já tem as colunas que uso» (UE06))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: não começar as contas do zero (U0-04)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="264.6" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Uma linha por item, com o preço copiado à mão&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(de cada site (UE06))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: juntar num só sítio preços que estão em vários sites&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="327.0" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Total por pessoa&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(303 € (UE06); 322 € com as novas datas (UE09); 294 € = 322 − 28 (UE12))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: decidir sempre por pessoa&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="402.0" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Linha riscada&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«isto é para turistas» (UE12). Apresentação: riscada e não apagada, continua à vista)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: mostrar ao grupo o que foi cortado (U0-17)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="270.1" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Custo real espalhado: falta o transporte até ao aeroporto&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(comboio + metro ≈13 € por sentido, ou autocarro 8 € (UE04), ficam fora da folha; o custo está entre o comparador, o transporte e a folha (U0-07))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="345.0" width="198.0" height="75.6" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="345.0" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Ninguém abre a ligação partilhada&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«manda print» (UE17, U0-18))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="432.6" width="198.0" height="37.8" as="geometry"/></mxCell><mxCell id="c32" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="432.6" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c33" value="Folha de cálculo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="171.6" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c34" value="duplicada da viagem anterior · UE06, UE09, UE12, UE17" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="187.8" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="160.6" width="490.0" height="263.3" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;U0:&lt;/b&gt; [vídeo] «Cracóvia por 150 €» + «bora?»" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="590.5" width="312.0" height="24.6" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Amigo A:&lt;/b&gt; «dormitório não»" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="621.1" width="312.0" height="24.6" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;U0:&lt;/b&gt; «malta, subiu»" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="651.7" width="312.0" height="24.6" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;U0:&lt;/b&gt; [ligação] folha de cálculo" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="682.3" width="312.0" height="24.6" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Amigo A:&lt;/b&gt; «manda print»" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="712.9" width="312.0" height="24.6" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;U0:&lt;/b&gt; [imagem] captura de ecrã da folha" style="rounded=0;fillColor=#ffffff;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="743.5" width="312.0" height="24.6" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Grupo de mensagens:&lt;/b&gt; U0, Amigo A, Amigo B" style="rounded=0;fillColor=#f1f1f1;strokeColor=#b0b0b0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="336.0" y="560.0" width="328.0" height="24.6" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="336.0" y="590.5" width="328.0" height="186.6" as="geometry"/></mxCell><mxCell id="c45" value="Desenho a partir de UE01, UE05, UE08 e UE17, pela ordem de envio. Só mensagens registadas." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#666666;fontStyle=2;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="336.0" y="777.1" width="328.0" height="28.4" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9a9a9a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="335.0" y="559.0" width="330.0" height="247.5" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Porque aparece aqui e no modelo de fluxo?&lt;/b&gt; No modelo de fluxo, o grupo é o &lt;i&gt;lugar&lt;/i&gt; onde U0 e os amigos coordenam: mostra quem comunica com quem. Aqui mostra-se a &lt;i&gt;conversa&lt;/i&gt; como coisa que U0 criou (UE01) e usa: as suas partes, a intenção de cada parte e onde atrapalha." style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="266.0" y="816.5" width="468.0" height="52.0" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Membros do grupo&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(criado por U0 na hora, com a 1.ª mensagem (UE01, U0-02))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: decidir em grupo&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="547.1" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Vídeo + «bora?»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(primeira mensagem do grupo (UE01))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: convencer os amigos a ir&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="609.4" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;«dormitório não»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(o dormitório é afastado aqui (UE05))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: decidir o alojamento em grupo&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="659.2" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;«malta, subiu»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(enviado depois de dois dias sem resposta (UE08))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: apressar a decisão do grupo&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="709.0" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Ninguém abre a ligação&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(para ver a folha é preciso abrir a ligação; o grupo pede «manda print» (UE17, U0-18))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: pôr o grupo a par das contas&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="663.1" width="198.0" height="63.0" as="geometry"/></mxCell><mxCell id="c52" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="663.1" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;Captura de ecrã em vez da ligação&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(pedida pelo Amigo A (UE17))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: mostrar as contas dentro da conversa&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="738.1" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c54" value="Grupo de mensagens" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="523.4" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c55" value="U0, Amigo A e Amigo B · UE01, UE05, UE08, UE17" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="539.6" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="512.4" width="490.0" height="367.1" as="geometry"/></mxCell><mxCell id="c57" value="Roteiro do ChatGPT: 4 itens" style="rounded=0;fillColor=#e6f0df;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="956.1" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c58" value="«o que combinámos» (atividades)" style="rounded=0;fillColor=#e6f0df;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="987.2" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Roteiro do ChatGPT&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(copiado num intervalo entre aulas (UE10))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: ter ideias de atividades baratas&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="949.8" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;O que foi combinado&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(registado depois do encontro no café (UE18))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: ficar com registo do que foi combinado (U0-19)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="999.5" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;«não sei se isto é verdade, vou ver no mapa»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(as notas não dizem se cada item é verdadeiro: U0 tem de verificar no mapa (UE10))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="937.2" width="198.0" height="63.0" as="geometry"/></mxCell><mxCell id="c62" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJ