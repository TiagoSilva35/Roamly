ce=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="909.5" width="490.0" height="114.0" as="geometry"/></mxCell><mxCell id="c68" value="Sítio de comida de rua" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="1151.1" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c69" value="(outros sítios da lista: não registados)" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#777777;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="1182.3" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Sítio do vídeo&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(recomendado pelo criador de conteúdo, acrescentado à lista; U0-13)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: guardar os sítios a visitar&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="1138.5" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Mapa&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(usado para verificar as ideias do ChatGPT: «vou ver no mapa»; confirma 2 e descarta 1 (UE10))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: confirmar que as ideias são verdadeiras&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10