.2" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;Preço anunciado no vídeo&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(enviado como primeira mensagem do novo grupo: «bora?»)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: convencer os amigos a ir&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="1282.5" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b&gt;Recomendação do criador de conteúdo&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(reaberta mais tarde e acrescentada ao mapa)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: ter ideias de sítios para visitar (U0-13)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="1344.8" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c79" value="Vídeo guardado" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="1259.5" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c80" value="rede social · UE01, UE11" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="1275.7" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c74" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3