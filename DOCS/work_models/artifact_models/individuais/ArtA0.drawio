<mxfile host="drawio" type="device"><diagram name="ArtA0" id="ArtA0"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1156" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Artifact models: A0 (agente de viagens de balcão)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="24.0" as="geometry"/></mxCell><mxCell id="c2" value="Os artefactos que A0 usou ao balcão. Apenas o que consta da entrevista a A0." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="48.0" width="956.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="22.0" y="73.0" width="10.0" height="17.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;color:#9a3200&quot;&gt;Breakdown: onde o artefacto atrapalha o trabalho&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Nome da parte&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#555555&quot;&gt;(observação, apresentação)&lt;/i&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: a intenção que a parte serve&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="75.5" width="604.3" height="12.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i&gt;Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="94.0" width="956.0" height="11.4" as="geometry"/></mxCell><mxCell id="c6" value="A apresentação (layout, cores, letra) não é mostrada: a entrevista não tem fotos do balcão («sem fotos do balcão»). Por isso cada modelo mostra só as partes que A0 mostrou ou referiu." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="113.4" width="956.0" height="12.6" as="geometry"/></mxCell><mxCell id="c8" value="Ideias" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="194.6" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c9" value="Voos" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="225.8" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c10" value="Sítios onde gostariam de ficar" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="256.9" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c11" value="Cidade 1 ↔ cidade 2" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="288.1" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c12" value="Monumento (no dia previsto)" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="319.3" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Roteiro inteiro&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(o casal quer «algo deste género» (AE03))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: mostrar a viagem que o casal já imaginou&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="148.0" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Ideias, voos e sítios&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«algumas ideias, voos e sítios onde gostariam de ficar» (AE03))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: dizer o que quer fazer e onde quer ficar&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="210.4" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Cidades e monumento&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(o que A0 lê para ver se a viagem funciona (AE04))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: verificar se o roteiro é viável&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="285.3" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Falta informação: orçamento, datas flexíveis, «o que não abdicam»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(A0 tem de perguntar; A0-06)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="226.5" width="198.0" height="50.4" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="226.5" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c18" value="Roteiro impresso" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="159.0" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c19" value="trazido pelo casal · AE03, AE04" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="175.2" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="148.0" width="490.0" height="207.5" as="geometry"/></mxCell><mxCell id="c21" value="Hotel X" style="rounded=0;fillColor=#e6f0df;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="432.1" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c22" value="não fiar na foto" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="463.3" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c23" value="pedir quarto nos pisos de cima" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="494.5" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Fornecedor&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: conhecer os fornecedores (fecho)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="432.1" width="214.0" height="25.2" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Notas de A0 sobre ele&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«hotel X: não fiar na foto; pedir quarto nos pisos de cima» (AE08))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: lembrar o que só A0 sabe de cada hotel&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="469.3" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Só neste caderno pessoal&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«Isto não está em lado nenhum.» (AE08, A0-10))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="488.2" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c27" value="Caderno de fornecedores" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="396.5" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c28" value="AE08" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="412.7" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c20" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="385.5" width="490.0" height="145.1" as="geometry"/></mxCell><mxCell id="c30" value="Logótipo da agência" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="620.8" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c31" value="Dados copiados do portal" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="652.0" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Modelo da agência&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(documento com logótipo)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: mostrar que a proposta vem da agência&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="608.2" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Dados copiados do portal&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(copiados à mão para o modelo)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: juntar numa proposta o que o casal pediu&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="670.6" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Procurar e copiar dados entre sistemas&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«grande parte da manhã»; fecho, A0-07)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="645.7" width="198.0" height="37.8" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="645.7" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Uso: enviada por email&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(prometida «o mais rápido possível» (AE05))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: responder depressa ao casal&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="695.5" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;O casal vai comparar&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«pensar e comparar online» (AE06))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="745.3" width="214.0" height="25.2" as="geometry"/></mxCell><mxCell id="c38" value="Proposta" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="585.2" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c39" value="modelo da agência · AE05, AE06" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="601.4" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="574.2" width="490.0" height="114.0" as="geometry"/></mxCell><mxCell id="c41" value="Sistema: algumas conversas pendentes" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="859.0" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c42" value="Caixa de correio partilhada" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="890.2" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c43" value="«ligar a cliente X» (papel autocolante no monitor)" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="921.4" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Conversas pendentes&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: saber o que falta responder&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="859.0" width="214.0" height="25.2" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Correio partilhado&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: receber os pedidos novos (AE02)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="896.2" width="214.0" height="25.2" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Papel autocolante no monitor&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(lembrete em papel, fora do sistema e do correio)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: não se esquecer de ligar ao cliente&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="908.8" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c47" value="Sistema com papel autocolante" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="823.5" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c48" value="monitor do balcão · AE01" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="839.6" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="812.5" width="490.0" height="145.1" as="geometry"/></mxCell><mxCell id="c50" value="«vi opções de alojamento parecidas, por menos 10 ou 20 euros por noite»" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="1047.8" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Opções parecidas mais baratas&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(menos 10 ou 20 € por noite)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: (do cliente) conseguir um preço mais baixo&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="1035.2" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;A0 suspira: «É isto, lá vamos nós.»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(a pressão sobre o preço é uma influência cultural: está no modelo cultural (A0-02))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="1041.5" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c53" value="Email do cliente" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="1012.2" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c54" value="AE02" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="1028.4" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y