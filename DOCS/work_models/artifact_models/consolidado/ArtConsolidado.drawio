<mxfile host="drawio" type="device"><diagram name="ArtConsolidado" id="ArtConsolidado"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="956" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Artifact models consolidados" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="24.0" as="geometry"/></mxCell><mxCell id="c2" value="Os artefactos de U0 e de A0 agrupados pela mesma intenção ou uso no trabalho. Apenas o que consta dos artifact models individuais e das entrevistas." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="48.0" width="956.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="22.0" y="73.0" width="10.0" height="17.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;color:#9a3200&quot;&gt;Breakdown: onde o artefacto atrapalha o trabalho&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Nome da parte&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#555555&quot;&gt;(observação, apresentação)&lt;/i&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: a intenção que a parte serve&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="75.5" width="604.3" height="12.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i&gt;Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="94.0" width="956.0" height="11.4" as="geometry"/></mxCell><mxCell id="c6" value="Cada parte mostra a variante de U0 (a verde) e de A0 (a laranja)." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="113.4" width="956.0" height="12.6" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Molde de partida&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; colunas da folha da viagem anterior&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; modelo da agência, com logótipo&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="194.6" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Itens copiados de outros sistemas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; preços de cada site, copiados à mão&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; dados do portal&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="252.1" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Total&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; total por pessoa: 303 € … 294 €&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; não registado&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="309.7" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Itens cortados, à vista&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; linha riscada: mina de sal (28 €)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; —&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="367.2" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Envio a quem decide&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; ligação no grupo; depois uma captura de ecrã&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; por email, «o mais rápido possível»&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="424.8" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Artefacto inteiro&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(montado à mão a partir de dados de outros sistemas, nos dois casos (UE06, AE05))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: U0: ver se a viagem cabe nos 300 € por pessoa; A0: juntar numa proposta o que o casal pediu&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="148.0" width="214.0" height="75.6" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Molde&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(U0: «já tem as colunas que uso»; A0: documento com logótipo)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: U0: não começar as contas do zero (U0-04); A0: mostrar que a proposta vem da agência&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="235.5" width="214.0" height="75.6" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Itens de custo&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: U0: juntar num só sítio preços que estão em vários sites&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="323.1" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Total por pessoa&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(303 € (UE06) → 322 € (UE09) → 294 € (UE12))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: decidir sempre por pessoa; ver se cabe nos 300 €&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="372.9" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Anotação informal&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(riscada e não apagada (UE12))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: mostrar ao grupo o que foi cortado (U0-17)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="447.9" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Procurar e copiar dados entre sistemas&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(A0: «grande parte da manhã» (fecho, A0-07))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="252.7" width="198.0" height="50.4" as="geometry"/></mxCell><mxCell id="c19" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="252.7" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Custo real espalhado&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(o transporte até ao aeroporto fica fora da folha (U0-07))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="316.6" width="198.0" height="37.8" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="316.6" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Ninguém abre a ligação partilhada&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(U0: «manda print» (UE17, U0-18); em A0 não se sabe se o casal abriu o email)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="425.4" width="198.0" height="50.4" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="425.4" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="1. Proposta / orçamento da viagem" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="159.0" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c25" value="Folha de cálculo (U0: UE06, UE09, UE12, UE17) + Proposta no modelo da agência (A0: AE05, AE06)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="175.2" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="148.0" width="490.0" height="339.4" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Ideias de sítios e atividades&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; 4 itens do roteiro do ChatGPT; sítio de comida de rua do vídeo&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; ideias do casal&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="598.2" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;De onde vêm as ideias&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; ChatGPT; criador de conteúdo (vídeo)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; o casal (fonte não registada)&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="655.8" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Voos e sítios onde ficar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; — (estão na folha de cálculo)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; voos e sítios onde gostariam de ficar&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="713.3" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Localização&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; lista do mapa&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; cidades e monumento no dia previsto&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="770.9" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Estado de verificação&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#1f7a74&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; confirma 2, descarta 1 (UE10)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#a8461a&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; —&lt;/span&gt;" style="rounded=0;fillColor=#ffffff;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="828.5" width="468.0" height="51.6" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Artefacto inteiro&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(as ideias chegam de fora e é preciso verificá-las (tema do affinity))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: A0: mostrar a viagem que o casal já imaginou&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="540.2" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Ideias&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: U0: ter ideias de atividades baratas; A0: dizer o que quer fazer e onde quer ficar&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="615.2" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Fonte&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(U0: ChatGPT e criador de conteúdo (UE10, UE11, U0-13))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="665.0" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Mapa / lugares&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: U0: confirmar que as ideias são verdadeiras; A0: verificar se o roteiro é viável&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="777.8" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Anotação informal&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(itens confirmados ou descartados (UE10))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: U0: só contar com o que é verdade&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="835.3" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Falta informação: orçamento, datas flexíveis, «o que não abdicam»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(A0 tem de perguntar (A0-06))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="690.4" width="198.0" height="50.4" as="geometry"/></mxCell><mxCell id="c38" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="690.4" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;«não sei se isto é verdade, vou ver no mapa»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(as notas não dizem se cada item é verdadeiro: U0 tem de verificar no mapa (UE10))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="822.8" width="198.0" height="63.0" as="geometry"/></mxCell><mxCell id="c40" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="822.8" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c41" value="2. Roteiro / lista de ideias" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="551.2" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c42