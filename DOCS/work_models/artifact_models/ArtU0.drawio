mxCell><mxCell id="c21" value="Total por pessoa" style="rounded=0;fillColor=#fff2b3;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="639.0" y="244.5" width="68.0" height="34.0" as="geometry"/></mxCell><mxCell id="c22" value="2" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="267.0" y="278.5" width="20.0" height="34.0" as="geometry"/></mxCell><mxCell id="c23" value="Opção" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="287.0" y="278.5" width="68.0" height="34.0" as="geometry"/></mxCell><mxCell id="c24" value="11h30" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="355.0" y="278.5" width="52.0" height="34.0" as="geometry"/></mxCell><mxCell id="c25" value="(falta)" style="rounded=0;fillColor=#fff4ea;strokeColor=#f07a1a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#9a3200;fontStyle=2;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="407.0" y="278.5" width="76.0" height="34.0" as="geometry"/></mxCell><mxCell id="c26" value="Quarto privado para 3 · 4 noites" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="483.0" y="278.5" width="92.0" height="34.0" as="geometry"/></mxCell><mxCell id="c27" value="Mina de sal" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#888888;fontStyle=8;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="575.0" y="278.5" width="64.0" height="34.0" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="639.0" y="278.5" width="68.0" height="34.0" as="geometry"/></mxCell><mxCell id="c29" value="3" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="267.0" y="312.5" width="20.0" height="30.0" as="geometry"/></mxCell><mxCell id="c30" value="€ por pessoa" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="287.0" y="312.5" width="68.0" height="30.0" as="geometry"/></mxCell><mxCell id="c31" value="179 €" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="355.0" y="312.5" width="52.0" height="30.0" as="geometry"/></mxCell><mxCell id="c32" value="(falta)" style="rounded=0;fillColor=#fff4ea;strokeColor=#f07a1a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#9a3200;fontStyle=2;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="407.0" y="312.5" width="76.0" height="30.0" as="geometry"/></mxCell><mxCell id="c33" value="96 € (24 € × 4)" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="483.0" y="312.5" width="92.0" height="30.0" as="geometry"/></mxCell><mxCell id="c34" value="28 €" style="rounded=0;fillColor=#ffffff;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#888888;fontStyle=8;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="575.0" y="312.5" width="64.0" height="30.0" as="geometry"/></mxCell><mxCell id="c35" value="303 € … 294 €" style="rounded=0;fillColor=#fff2b3;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="639.0" y="312.5" width="68.0" height="30.0" as="geometry"/></mxCell><mxCell id="c37" value="Folha de cálculo · cópia da folha da viagem anterior" style="rounded=0;fillColor=#f1f3f4;strokeColor=#c8c8c8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="267.0" y="208.2" width="466.0" height="21.4" as="geometry"/></mxCell><mxCell id="c38" value="" style="rounded=0;fillColor=#ffffff;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="267.0" y="229.5" width="466.0" height="113.0" as="geometry"/></mxCell><mxCell id="c39" value="Print reconstruído e anonimizado a partir de UE06, UE09 e UE12." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#666666;fontStyle=2;align=left;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="267.0" y="342.5" width="466.0" height="16.2" as="geometry"/></mxCell><mxCell id="c36" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9a9a9a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="207.2" width="468.0" height="152.6" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Folha inteira&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(duplicada da viagem anterior; preços copiados à mão (UE06))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: ver se a viagem cabe nos 300 € por pessoa&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="189.7" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Colunas da viagem anterior&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«já tem as colunas que uso». Apresentação: cabeçalho a negrito, com fundo azul)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: não começar as contas do zero&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="264.6" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Preços copiados à mão&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(de cada site (UE06). O valor do voo, 179 €, é deduzido: 303 − 96 − 28)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: juntar num só sítio preços que estão em vários sites&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="327.0" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Falta a coluna do transporte até ao aeroporto&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(comboio + metro ≈13 € por sentido, ou autocarro 8 € (UE04), ficam fora das contas)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="200.1" width="198.0" height="63.0" as="geometry"/></mxCell><mxCell id="c44" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="200.1" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Linha riscada&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«isto é para turistas» (UE12). Apresentação: riscada e não apagada, continua à vista)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: mostrar ao grupo o que foi cortado (U0-17)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="296.1" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Total por pessoa&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(303 € (UE06); 322 € com as novas datas (UE09); 294 € = 322 − 28 (UE12). Apresentação: a negrito, em destaque, na última coluna)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: decidir sempre por pessoa&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="371.0" width="214.0" height="75.6" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Custo real espalhado&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(comparador, transporte até ao aeroporto, folha de cálculo: o total da folha não é o custo real (U0-07))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="458.6" width="198.0" height="50.4" as="geometry"/></mxCell><mxCell id="c48" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="458.6" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Ninguém abre a ligação partilhada&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(«manda print» (UE17, U0-18))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="521.0" width="198.0" height="37.8" as="geometry"/></mxCell><mxCell id="c50" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="521.0" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c51" value="Folha de cálculo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="171.6" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c52" value="duplicada da viagem anterior · UE06, UE09, UE12, UE17" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="187.8" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="160.6" width="490.0" height="210.2" as="geometry"/></mxCell><mxCell id="c63" value="▶&amp;nbsp; vídeo: «Cracóvia por 150 €»" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#3d3d3d;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#ffffff;fontStyle=0;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="471.0" y="684.9" width="180.0" height="28.0" as="geometry"/></mxCell><mxCell id="c64" value="bora?" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="471.0" y="712.9" width="180.0" height="18.6" as="geometry"/></mxCell><mxCell id="c56" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#d9fdd3;strokeColor=#b5dcae;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="466.0" y="679.9" width="190.0" height="56.6" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b style=&quot;color:#1f7a8c&quot;&gt;Amigo A&lt;/b&gt;&lt;br&gt;dormitório não" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#dddddd;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="743.5" width="120.0" height="37.2" as="geometry"/></mxCell><mxCell id="c58" value="malta, subiu" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#d9fdd3;strokeColor=#b5dcae;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="556.0" y="787.7" width="100.0" height="24.6" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Folha de cálculo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#666666&quot;&gt;ligação partilhada&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#f2f2f2;strokeColor=#d6d6d6;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="471.0" y="824.3" width="180.0" height="36.0" as="geometry"/></mxCell><mxCell id="c59" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#d9fdd3;strokeColor=#b5dcae;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="466.0" y="819.3" width="190.0" height="46.0" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b style=&quot;color:#1f7a8c&quot;&gt;Amigo A&lt;/b&gt;&lt;br&gt;manda print" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#ffffff;strokeColor=#dddddd;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="344.0" y="872.3" width="110.0" height="37.2" as="geometry"/></mxCell><mxCell id="c66" value="captura de ecrã da folha&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;(imagem)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#bbbbbb;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#444444;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="471.0" y="921.5" width="180.0" height="46.0" as="geometry"/></mxCell><mxCell id="c61" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#d9fdd3;strokeColor=#b5dcae;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="466.0" y="916.5" width="190.0" height="56.0" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Grupo&lt;/b&gt; · U0, Amigo A, Amigo B" style="rounded=0;fillColor=#2f6f62;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#ffffff;fontStyle=0;align=left;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="336.0" y="648.3" width="328.0" height="24.6" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=0;fillColor=#ece5dd;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="336.0" y="679.9" width="328.0" height="301.6" as="geometry"/></mxCell><mxCell id="c67" value="Print reconstruído e anonimizado a partir de UE01, UE05, UE08 e UE17." style="rounded=0;fillColor=#ffffff;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#666666;fontStyle=2;align=left;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="336.0" y="981.5" width="328.0" height="16.2" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#9a9a9a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="335.0" y="647.3" width="330.0" height="351.3" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Porque aparece aqui e no modelo de fluxo?&lt;/b&gt; No modelo de fluxo, o grupo é o &lt;i&gt;lugar&lt;/i&gt; onde U0 e os amigos coordenam: mostra quem comunica com quem. Aqui mostra-se a &lt;i&gt;conversa&lt;/i&gt; como coisa que U0 criou (UE01) e usa: as suas partes, a apresentação, a intenção de cada parte e onde atrapalha. Pelo manual, artefactos são as coisas que as pessoas criam ou usam (pp. 102–103)." style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="266.0" y="1008.7" width="468.0" height="64.0" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;Membros do grupo&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(criado por U0 na hora, com a 1.ª mensagem (UE01, U0-02))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: decidir em grupo&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="635.4" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Vídeo + «bora?»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(primeira mensagem do grupo (UE01))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: convencer os amigos a ir&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="697.8" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;«dormitório não»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(o dormitório é afastado aqui (UE05))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: decidir o alojamento em grupo&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="747.6" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;«malta, subiu»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(enviado depois de dois dias sem resposta (UE08))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: apressar a decisão do grupo&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="797.4" width="214.0" height="50.4" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;Apresentação&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(mensagens de U0 à direita, a verde; as dos amigos à esquerda, com o nome. Vídeo, ligação e captura aparecem como pré-visualizações)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="662.4" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Ninguém abre a ligação&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(a folha não se vê na conversa: é preciso sair para a abrir («manda print»; U0-18))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: pôr o grupo a par das contas&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="817.1" width="198.0" height="50.4" as="geometry"/></mxCell><mxCell id="c75" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="817.1" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;Captura de ecrã em vez da ligação&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(pedida pelo Amigo A (UE17): a imagem vê-se logo na conversa)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: mostrar as contas sem sair da conversa&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="768.0" y="913.0" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c77" value="Grupo de mensagens" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="611.8" width="468.0" height="16.2" as="geometry"/></mxCell><mxCell id="c78" value="U0, Amigo A e Amigo B · UE01, UE05, UE08, UE17" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="266.0" y="627.9" width="468.0" height="11.4" as="geometry"/></mxCell><mxCell id="c53" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#eef7e8;gradientColor=#c3e3ae;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="255.0" y="600.8" width="490.0" height="482.9" as="geometry"/></mxCell><mxCell id="c80" value="Roteiro do ChatGPT: 4 itens" style="rounded=0;fillColor=#e6f0df;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="1160.2" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c81" value="«o que combinámos» (atividades)" style="rounded=0;fillColor=#e6f0df;strokeColor=#aac99a;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="266.0" y="1191.4" width="468.0" height="25.2" as="geometry"/></mxCell><mxCell id="c82" value="&lt;b&gt;Roteiro do ChatGPT&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(copiado num intervalo entre aulas (UE10))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: ter ideias de atividades baratas&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="1154.0" width="214.0" height="37.8" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;O que foi combinado&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(registado depois do encontro no café (UE18))&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: ficar com registo do que foi combinado (U0-19)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=right;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="18.0" y="1203.7" width="214.0" height="63.0" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;«não sei se isto é verdade, vou ver no mapa»&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(as notas não dizem se cada item é verdadeiro: U0 tem de verificar no mapa (UE10))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="1141.4" width="198.0" height="63.0" as="geometry"/></mxCell><mxCell id="c85" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="768.0" y="1141.4" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b style=&quot;color:#9a3200&quot;&gt;Breakdown:&lt;/b&gt; &lt;b style=&quot;color:#9a3200&quot;&gt;Ninguém escreve no café&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;color:#555555&quot;&gt;(U0 regista depois (UE18, U0-19))&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="784.0" y="1216.3" width="198.0" height="25.2" as="geometry"/></mxCell><mxCell id="c87" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeome