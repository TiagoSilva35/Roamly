22;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=7;fontSize=11.5;strokeColor=#aac99a;fillColor=#e6f0df;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="626.3" y="216.5" width="111.2" height="23.0" as="geometry"/></mxCell><mxCell id="c45" value="Preços de cada site" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=7;fontSize=11.5;strokeColor=#aac99a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="415.5" y="239.5" width="210.8" height="23.0" as="geometry"/></mxCell><mxCell id="c46" value="…" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=7;fontSize=11.5;strokeColor=#aac99a;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="626.3" y="239.5" width="111.2" height="23.0" as="geometry"/></mxCell><mxCell id="c47" value="Visita à mina de sal" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=7;fontSize=11.5;strokeColor=#aac99a;fillColor=#ffffff;fontStyle=8;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="415.5" y="262.5" width="210.8" height="23.0" as="geometry"/></mxCell><mxCell id="c48" value="28 €" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=7;fontSize=11.5;strokeColor=#aac99a;fillColor=#ffffff;fontStyle=8;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="626.3" y="262.5" width="111.2" height="23.0" as="geometry"/></mxCell><mxCell id="c49" value="Total por pessoa" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=7;fontSize=11.5;strokeColor=#aac99a;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="415.5" y="285.5" width="210.8" height="23.0" as="geometry"/></mxCell><mxCell id="c50" value="303 € … 294 €" style="rounded=0;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=7;fontSize=11.5;strokeColor=#aac99a;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="626.3" y="285.5" width="111.2" height="23.0" as="geometry"/></mxCell><mxCell id="c51" value='&lt;font color="#222222"&gt;Folha inteira&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(para ver se a viagem cabe nos 300 € por pessoa)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="98.2" y="181.0" width="253.8" height="29.9" as="geometry"/></mxCell><mxCell id="c52" value='&lt;font color="#222222"&gt;Colunas da viagem anterior&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«já tem as colunas que uso»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="196.6" y="221.0" width="155.4" height="29.9" as="geometry"/></mxCell><mxCell id="c53" value='&lt;font color="#222222"&gt;Preços copiados à mão&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(de cada site)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="218.6" y="261.0" width="133.4" height="29.9" as="geometry"/></mxCell><mxCell id="c54" value='&lt;font color="#222222"&gt;Custo real espalhado&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(comparador, transporte até ao aeroporto, folha de cálculo; U0-07)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20.5" y="301.0" width="331.5" height="29.9" as="geometry"/></mxCell><mxCell id="c55" value='&lt;font color="#9a3200"&gt;Ninguém abre a ligação partilhada&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«manda print»; U0-18)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="181.0" width="185.0" height="45.5" as="geometry"/></mxCell><mxCell id="c56" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="181.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c57" value='&lt;font color="#222222"&gt;Linha riscada&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«isto é para turistas»; justifica ao grupo o que foi cortado; U0-17)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="266.0" width="185.0" height="44.2" as="geometry"/></mxCell><mxCell id="c58" value='&lt;font color="#222222"&gt;Total por pessoa&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(303 € no início, acima de 300 € (UE06); 322 € depois de refazer a pesquisa com as novas datas (UE09); 294 € depois de riscar a mina de sal: 322 − 28 (UE12))&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="320.0" width="185.0" height="87.1" as="geometry"/></mxCell><mxCell id="c59" value='&lt;font color="#222222"&gt;Roteiro do ChatGPT&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(copiado num intervalo entre aulas, para verificar no mapa)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="56.0" y="499.0" width="296.0" height="29.9" as="geometry"/></mxCell><mxCell id="c60" value='&lt;font color="#222222"&gt;O que foi combinado&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(registado depois do encontro no café)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="155.7" y="539.0" width="196.3" height="29.9" as="geometry"/></mxCell><mxCell id="c61" value='&lt;font color="#222222"&gt;«não sei se isto é verdade, vou ver no mapa»&lt;/font&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="499.0" width="185.0" height="31.2" as="geometry"/></mxCell><mxCell id="c62" value='&lt;font color="#222222"&gt;Ninguém escreve no café&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(U0 regista depois)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="540.0" width="144.1" height="29.9" as="geometry"/></mxCell><mxCell id="c63" value='&lt;font color="#222222"&gt;Sítio do vídeo&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(recomendado pelo criador de conteúdo, acrescentado à lista; U0-13)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="14.0" y="662.0" width="338.0" height="44.2" as="geometry"/></mxCell><mxCell id="c64" value='&lt;font color="#222222"&gt;Mapa&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(usado para verificar as ideias do ChatGPT: «vou ver no mapa»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="623.0" width="185.0" height="44.2" as="geometry"/></mxCell><mxCell id="c65" value='&lt;font color="#222222"&gt;Preço anunciado no vídeo&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(enviado como primeira mensagem do novo grupo: «bora?»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="48.0" y="815.0" width="304.0" height="29.9" as="geometry"/></mxCell><mxCell id="c66" value='&lt;font color="#222222"&gt;Recomendação do criador de conteúdo&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(reaberta mais tarde e acrescentada ao mapa)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="117.2" y="855.0" width="234.8" height="29.9" as="geometry"/></mxCell><mxCell id="c67" value='&lt;font color="#222222"&gt;Início do grupo&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(o grupo nasce com a primeira mensagem; a decisão acontece nele: U0-02)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="14.0" y="977.0" width="338.0" height="44.2" as="geometry"/></mxCell><mxCell id="c68" value='&lt;font color="#222222"&gt;Respostas dos amigos&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(o dormitório é afastado aqui)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="200.3" y="1031.0" width="151.7" height="29.9" as="geometry"/></mxCell><mxCell id="c69" value='&lt;font color="#222222"&gt;Aviso de subida de preço&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(enviado depois de dois dias sem resposta)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="131.8" y="1071.0" width="220.2" height="29.9" as="geometry"/></mxCell><mxCell id="c70" value='&lt;font color="#9a3200"&gt;Dois dias sem resposta do grupo&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(entretanto o voo sobe 19 €; U0-09)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="1037.0" width="183.4" height="29.9" as="geometry"/></mxCell><mxCell id="c71" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="1037.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c72" value='&lt;font color="#9a3200"&gt;Ninguém abre a ligação&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«manda print»; U0-18)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="1077.0" width="134.8" height="29.9" as="geometry"/></mxCell><mxCell id="c73" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="1077.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c74" value='&lt;font color="#222222"&gt;Captura de ecrã em vez da ligação&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(pedida pelo Amigo A)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="1127.0" width="185.0" height="45.5" as="geometry"/></mxCell><mxCell id="c75" value='&lt;font color="#222222"&gt;Página inteira&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(o passo de pagamento do voo)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="188.7" y="1225.0" width="163.3" height="29.9" as="geometry"/></mxCell><mxCell id="c76" value='&lt;font color="#222222"&gt;Bagagem de porão&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(U0 decide levar só mochila pequena)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="158.7" y="1294.0" width="193.3" height="29.9" as="geometry"/></mxCell><mxCell id="c77" value='&lt;font color="#9a3200"&gt;A bagagem só aparece no pagamento&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«isto ninguém diz»; U0-08)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="1294.0" width="185