<mxfile host="drawio" type="device"><diagram name="ArtU0" id="ArtU0"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="2020" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Artifact models: U0 (organizador(a) do grupo)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="24.0" as="geometry"/></mxCell><mxCell id="c2" value="Os artefactos que U0 usou para planear a viagem a Cracóvia. Apenas o que consta da entrevista a U0." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="48.0" width="956.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="22.0" y="73.0" width="10.0" height="17.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;color:#9a3200&quot;&gt;Breakdown: onde o artefacto atrapalha o trabalho&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;Nome da parte&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#555555&quot;&gt;(observação, apresentação)&lt;/i&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i style=&quot;color:#6b3fa0&quot;&gt;Intent: a intenção que a parte serve&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="75.5" width="604.3" height="12.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i&gt;Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="94.0" width="956.0" height="11.4" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Prints.&lt;/b&gt; A folha de cálculo e o grupo de mensagens são mostrados como &lt;b&gt;prints reconstruídos e anonimizados&lt;/b&gt; do que U0 mostrou no portátil e no telemóvel (a entrevista não guardou capturas de ecrã). Servem para mostrar a apresentação: layout, cores e destaques. Nos outros artefactos mostram-se só as partes." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#333333;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="113.4" width="956.0" height="25.2" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="267.0" y="229.5" width="20.0" height="15.0" as="geometry"/></mxCell><mxCell id="c9" value="A" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="287.0" y="229.5" width="68.0" height="15.0" as="geometry"/></mxCell><mxCell id="c10" value="B" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="355.0" y="229.5" width="52.0" height="15.0" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=0;fillColor=#f1f3f4;strokeColor=#f07a1a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="407.0" y="229.5" width="76.0" height="15.0" as="geometry"/></mxCell><mxCell id="c12" value="C" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="483.0" y="229.5" width="92.0" height="15.0" as="geometry"/></mxCell><mxCell id="c13" value="D" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="575.0" y="229.5" width="64.0" height="15.0" as="geometry"/></mxCell><mxCell id="c14" value="E" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9;fontColor=#666666;fontStyle=0;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="639.0" y="229.5" width="68.0" height="15.0" as="geometry"/></mxCell><mxCell id="c15" value="1" style="rounded=0;fillColor=#f1f3f4;strokeColor=#d0d0d0;strokeWidth=1;html=1;whiteSpace=wrap;over