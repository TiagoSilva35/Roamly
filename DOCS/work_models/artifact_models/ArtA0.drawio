<mxfile host="drawio" type="device"><diagram name="ArtA0" id="ArtA0"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1237" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c5" value="" style="rounded=1;arcSize=2;fillColor=#eef7e8;gradientColor=#c3e3ae;strokeColor=#6aa84f;" vertex="1" parent="1"><mxGeometry x="404.0" y="172.0" width="345.0" height="199.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=2;fillColor=#eef7e8;gradientColor=#c3e3ae;strokeColor=#6aa84f;" vertex="1" parent="1"><mxGeometry x="404.0" y="454.0" width="345.0" height="139.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=2;fillColor=#eef7e8;gradientColor=#c3e3ae;strokeColor=#6aa84f;" vertex="1" parent="1"><mxGeometry x="404.0" y="637.0" width="345.0" height="139.0" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=2;fillColor=#eef7e8;gradientColor=#c3e3ae;strokeColor=#6aa84f;" vertex="1" parent="1"><mxGeometry x="404.0" y="913.0" width="345.0" height="139.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=2;fillColor=#eef7e8;gradientColor=#c3e3ae;strokeColor=#6aa84f;" vertex="1" parent="1"><mxGeometry x="404.0" y="1109.0" width="345.0" height="91.0" as="geometry"/></mxCell><mxCell id="c1" value="Artifact models: A0 (agente de viagens de balcão)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="962.0" height="23.0" as="geometry"/></mxCell><mxCell id="c2" value="Os artefactos que A0 usou ao balcão. Apenas o que consta da entrevista a A0." style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="45.0" width="962.0" height="14.0" as="geometry"/></mxCell><mxCell id="c3" value="Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista." style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="22.0" y="91.0" width="962.0" height="11.0" as="geometry"/></mxCell><mxCell id="c4" value="A apresentação (layout, cores, letra) não é mostrada: a entrevista não tem fotos, por isso cada modelo mostra apenas as partes observadas ou referidas." style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10.5;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="116.0" width="962.0" height="12.0" as="geometry"/></mxCell><mxCell id="c10" value="Roteiro impresso" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="413.0" y="181.0" width="329.0" height="16.0" as="geometry"/></mxCell><mxCell id="c11" value="trazido pelo casal · AE03, AE04" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="413.0" y="197.0" width="329.0" height="11.0" as="geometry"/></mxCell><mxCell id="c12" value="Caderno de fornecedores" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="413.0" y="463.0" width="329.0" height="16.0" as="geometry"/></mxCell><mxCell id="c13" value="AE08" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="413.0" y="479.0" width="329.0" height="11.0" as="geometry"/></mxCell><mxCell id="c14" value="Proposta" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="413.0" y="646.0" width="329.0" height="16.0" as="geometry"/></mxCell><mxCell id="c15" value="modelo da agência · AE05, AE06" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="413.0" y="662.0" width="329.0" height="11.0" as="geometry"/></mxCell><mxCell id="c16" value="Sistema com papel autocolante" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="413.0" y="922.0" width="329.0" height="16.0" as="geometry"/></mxCell><mxCell id="c17" value="monitor do balcão · AE01" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="413.0" y="938.0" width="329.0" height="11.0" as="geometry"/></mxCell><mxCell id="c18" value="Email do cliente" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="413.0" y="1118.0" width="329.0" height="16.0" as="geometry"/></mxCell><mxCell id="c19" value="AE02" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=center;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#555555;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="413.0" y="1134.0" width="329.0" height="11.0" as="geometry"/></mxCell><mxCell id="x1" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="22.0" y="71.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="x2" value="Breakdown: onde o artefacto atrapalha o trabalho" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.6;fontColor=#9a3200;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="39.0" y="74.5" width="214.7" height="11.0" as="geometry"/></mxCell><mxCell id="x3" value="(itálico) = como a parte é usada ou porquê" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.6;fontColor=#222222;fontStyle=2;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="348.7" y="74.5" width="184.5" height="11.0" as="geometry"/></mxCell><mxCell id="c20" value="Ideias" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="216.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c21" value="Voos" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="246.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c22" value="Sítios onde gostariam de ficar" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="276.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c23" value="Cidade 1 ↔ cidade 2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="306.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c24" value="Monumento (no dia previsto)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="336.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c25" value="Hotel X" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#e6f0df;strokeColor=#aac99a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="415.0" y="498.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c26" value="não fiar na foto" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="431.0" y="528.0" width="307.0" height="24.0" as="geometry"/></mxCell><mxCell id="c27" value="pedir quarto nos pisos de cima" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="431.0" y="558.0" width="307.0" height="24.0" as="geometry"/></mxCell><mxCell id="c28" value="Logótipo da agência" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="681.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c29" value="Dados do portal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="711.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c30" value="A enviar por email" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="741.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c31" value="Sistema: algumas conversas pendentes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="957.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c32" value="Caixa de correio partilhada" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="987.0" width="323.0" height="24.0" as="geometry"/></mxCell><mxCell id="c33" value="«ligar a cliente X»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#fff6b8;strokeColor=#d8c25a;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="475.0" y="1017.0" width="263.0" height="24.0" as="geometry"/></mxCell><mxCell id="c34" value="«vi opções de alojamento parecidas, por menos 10 ou 20 euros por noite»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;align=left;spacingLeft=8;fontSize=11.5;fillColor=#ffffff;strokeColor=#aac99a;" vertex="1" parent="1"><mxGeometry x="415.0" y="1153.0" width="323.0" height="36.0" as="geometry"/></mxCell><mxCell id="c35" value='&lt;font color="#222222"&gt;Roteiro inteiro&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(o casal quer «algo deste género»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="173.4" y="181.0" width="178.6" height="29.9" as="geometry"/></mxCell><mxCell id="c36" value='&lt;font color="#9a3200"&gt;Falta informação: orçamento, datas flexíveis, «o que não abdicam»&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(A0 tem de perguntar; A0-06)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="181.0" width="185.0" height="61.1" as="geometry"/></mxCell><mxCell id="c37" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="181.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c38" value='&lt;font color="#9a3200"&gt;6 h de comboio entre as duas cidades&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(A0-05)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="310.0" width="185.0" height="45.5" as="geometry"/></mxCell><mxCell id="c39" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="310.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c40" value='&lt;font color="#9a3200"&gt;O monumento fecha no dia previsto&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(A0-05)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="365.0" width="185.0" height="45.5" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="365.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c42" value='&lt;font color="#222222"&gt;Fornecedor&lt;/font&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="282.6" y="502.0" width="69.4" height="15.6" as="geometry"/></mxCell><mxCell id="c43" value='&lt;font color="#222222"&gt;Notas de A0 sobre ele&lt;/font&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="225.9" y="532.0" width="126.1" height="15.6" as="geometry"/></mxCell><mxCell id="c44" value='&lt;font color="#222222"&gt;Só neste caderno pessoal&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«Isto não está em lado nenhum.»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="562.0" width="178.6" height="29.9" as="geometry"/></mxCell><mxCell id="c45" value='&lt;font color="#222222"&gt;Modelo da agência&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(documento com logótipo)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="216.8" y="685.0" width="135.2" height="29.9" as="geometry"/></mxCell><mxCell id="c46" value='&lt;font color="#222222"&gt;Dados copiados do portal&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(copiados à mão para o modelo)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="185.6" y="725.0" width="166.4" height="29.9" as="geometry"/></mxCell><mxCell id="c47" value='&lt;font color="#9a3200"&gt;Procurar e copiar dados entre sistemas&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«grande parte da manhã»; fecho, A0-07)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="715.0" width="185.0" height="59.8" as="geometry"/></mxCell><mxCell id="c48" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="715.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c49" value='&lt;font color="#222222"&gt;Email&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(prometido «o mais rápido possível»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="785.0" width="185.0" height="44.2" as="geometry"/></mxCell><mxCell id="c50" value='&lt;font color="#222222"&gt;O casal vai comparar&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(«pensar e comparar online»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="839.0" width="152.3" height="29.9" as="geometry"/></mxCell><mxCell id="c51" value='&lt;font color="#222222"&gt;Conversas pendentes&lt;/font&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="227.2" y="961.0" width="124.8" height="15.6" as="geometry"/></mxCell><mxCell id="c52" value='&lt;font color="#222222"&gt;Correio partilhado&lt;/font&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="248.6" y="991.0" width="103.4" height="15.6" as="geometry"/></mxCell><mxCell id="c53" value='&lt;font color="#222222"&gt;Papel autocolante no monitor&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(lembrete em papel, fora do sistema e do correio)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="1021.0" width="185.0" height="44.2" as="geometry"/></mxCell><mxCell id="c54" value='&lt;font color="#222222"&gt;Opções parecidas mais baratas&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(menos 10 ou 20 € por noite)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=right;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="175.2" y="1163.0" width="176.8" height="29.9" as="geometry"/></mxCell><mxCell id="c55" value='&lt;font color="#9a3200"&gt;Pressão sobre o preço&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style="font-size:11px" color="#444444"&gt;(AE02 [BD]; A0 suspira: «É isto, lá vamos nós.»)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="801.0" y="1163.0" width="185.0" height="44.2" as="geometry"/></mxCell><mxCell id="c56" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="784.0" y="1163.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="x4" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;fontColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundColor=none;exitX=1;exitY=0.268;exitDx=4;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x5" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;fontColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundCo