<mxfile host="drawio" type="device"><diagram name="UED-Viajante" id="UED-Viajante"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1059" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="User Environment Design: Viajante (organizador e membros do grupo)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=19;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="22.8" as="geometry"/></mxCell><mxCell id="c2" value="Áreas de foco do Roamly (versão base), a partir do diagrama de afinidade." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="44.8" width="956.0" height="13.2" as="geometry"/></mxCell><mxCell id="c4" value="1. Explorar ideias" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="89.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="c5" value="&lt;i&gt;Partir de uma ideia vinda de fora (uma ligação ou um texto) para começar a planear a viagem&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="112.2" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="c6" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="150.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c7" value="● Colar uma ligação (ex.: do vídeo que inspirou a viagem) ou escrever a ideia em texto" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="162.6" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="c8" value="○ Guardar a ligação ou o texto e mostrar de onde veio cada ideia" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="189.3" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="c9" value="● Indicar o orçamento por pessoa e as datas possíveis" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="216.1" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c10" value="● Pesquisar só por orçamento e datas, sem destino fixo («mês inteiro»)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="231.5" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="c11" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="262.3" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c12" value="&amp;gt; Comparar opções (2)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="274.7" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="c13" value="&amp;gt; Decidir com o grupo (5)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="293.1" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="c14" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="314.5" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c15" value="Ideia (ligação ou texto), fonte, orçamento por pessoa, datas possíveis" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="326.9" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="c16" value="Restrições" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="357.6" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c17" value="■ A IA aceita só texto e ligações; não analisa o conteúdo de vídeos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="370.0" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="c18" value="Afinidade: Tiro ideias de vídeos e lanço-as ao grupo; Uso o que a IA me sugere, mas verifico tudo; Tenho orgulho em gastar menos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="396.8" width="288.0" height="30.4" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="88.0" width="290.0" height="344.2" as="geometry"/></mxCell><mxCell id="c20" value="2. Comparar opções" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="89.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="c21" value="&lt;i&gt;Escolher voo e alojamento sabendo o preço que se vai mesmo pagar&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="112.2" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="c22" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=w