<mxfile host="drawio" type="device"><diagram name="UED-Viajante" id="UED-Viajante"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1358" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k1" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="88.0" width="290.0" height="366.0" as="geometry"/></mxCell><mxCell id="k2" value="1. Explorar ideias" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="89.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="k3" value="&lt;i&gt;Partir de uma ideia vinda de fora (uma ligação, um texto ou o roteiro que o cliente traz) para começar a planear a viagem&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="112.2" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="k4" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="150.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k5" value="● Colar uma ligação (ex.: do vídeo que inspirou a viagem) ou escrever a ideia em texto" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="162.6" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k6" value="○ Guardar a ligação ou o texto e mostrar de onde veio cada ideia" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="189.4" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k7" value="● Indicar o orçamento por pessoa, as datas possíveis e o que não se dispensa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="216.2" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k8" value="● Pesquisar só por orçamento e datas, sem destino fixo («mês inteiro»)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="243.0" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k9" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="273.8" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k10" value="&amp;gt; Comparar opções (2)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="286.2" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k11" value="&amp;gt; Decidir com o grupo ou o cliente (5)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="304.6" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k12" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="326.0" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k13" value="Ideia (ligação ou texto), fonte, orçamento por pessoa, datas possíveis, o que não se dispensa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="338.4" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k14" value="Restrições" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="369.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k15" value="■ A IA aceita só texto e ligações; não analisa o conteúdo de vídeos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="381.6" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k16" value="Afinidade: Tiro ideias de vídeos e lanço-as ao grupo; Uso o que a IA me sugere, mas verifico tudo; Tenho orgulho em gastar menos; Os clientes trazem ideias fechadas que nem sempre consigo cumprir" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="408.4" width="288.0" height="40.6" as="geometry"/></mxCell><mxCell id="k17" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="350.0" y="88.0" width="290.0" height="354.4" as="geometry"/></mxCell><mxCell id="k18" value="2. Comparar opções" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="89.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="k19" value="&lt;i&gt;Escolher voo e alojamento sabendo o preço que se vai mesmo pagar&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="112.2" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="k20" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="150.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k21" value="● Comparar voos e alojamentos de vários sites" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="162.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k22" value="● &lt;b&gt;&lt;font color=&quot;#A8461A&quot;&gt;[A]&lt;/font&gt;&lt;/b&gt; Juntar opções de fornecedores que não estão online, com as notas do agente sobre cada um" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="178.0" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k23" value="○ Mostrar o preço final, já com extras como a bagagem de porão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="204.8" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k24" value="○ Avisar quando não há transporte até ao aeroporto à hora a que é preciso chegar" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="231.6" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k25" value="● Juntar a opção ao orçamento" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="258.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k26" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="277.8" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k27" value="&amp;gt; Orçamento da viagem (3)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="290.2" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k28" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="311.6" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k29" value="Opção de voo, opção de alojamento, nota sobre o fornecedor" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="324.0" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k30" value="Restrições" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="343.4" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k31" value="■ Não usar mensagens de urgência para pressionar a decisão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="355.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k32" value="■ O Roamly não faz reservas: mostra as opções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="371.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k33" value="Afinidade: Os extras só aparecem quando vou pagar; O custo de chegar ao aeroporto fica fora das minhas contas; Sinto pressão para decidir depressa; Não pago taxa se o site não cobra; O meu valor está em conhecer os fornecedores" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="386.6" width="288.0" height="50.8" as="geometry"/></mxCell><mxCell id="k34" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="670.0" y="88.0" width="290.0" height="250.8" as="geometry"/></mxCell><mxCell id="k35" value="3. Orçamento da viagem" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="89.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="k36" value="&lt;i&gt;Ver o custo real por pessoa num só sítio&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="112.2" width="288.0" height="22.0" as="geometry"/></mxCell><mxCell id="k37" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="138.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k38" value="○ Somar o total por pessoa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="150.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k39" value="○ Atualizar o total quando um preço muda" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="166.0" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k40" value="○ Incluir o transporte até ao aeroporto" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="181.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k41" value="○ Avisar quando o total passa o orçamento por pessoa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="196.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k42" value="● Cortar um item e ver o efeito no total" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="212.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k43" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="231.6" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k44" value="&amp;gt; Roteiro (4)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="244.0" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k45" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="265.4" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k46" value="Orçamento por pessoa, item de custo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="277.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k47" value="Afinidade: Faço e refaço as contas eu mesmo/a; Copio à mão de um sistema para outro; Tenho orgulho em gastar menos; O custo de chegar ao aeroporto fica fora das minhas contas" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="293.2" width="288.0" height="40.6" as="geometry"/></mxCell><mxCell id="k48" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="509.0" width="290.0" height="335.2" as="geometry"/></mxCell><mxCell id="k49" value="4. Roteiro" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="510.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="k50" value="&lt;i&gt;Montar os dias da viagem com sugestões verificadas&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="533.2" width="288.0" height="22.0" as="geometry"/></mxCell><mxCell id="k51" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="559.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k52" value="○ Mostrar quanto sobra do orçamento por pessoa para atividades" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="571.6" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k53" value="● Pedir à IA um roteiro que caiba no que sobra" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="598.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k54" value="● Juntar atividades e sítios do criador de conteúdo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="613.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k55" value="● Ver as atividades no mapa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="629.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k56" value="○ Avisar quando um dia do roteiro não é viável (deslocações longas, sítios fechados)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="644.6" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k57" value="○ Mostrar a fonte de cada sugestão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="671.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k58" value="● Marcar uma sugestão como confirmada ou descartada" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="686.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k59" value="○ Mostrar o custo de cada atividade" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="702.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k60" value="● Cortar uma atividade e ver quanto sobra" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="717.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k61" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="737.0" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k62" value="&amp;gt; Decidir com o grupo ou o cliente (5)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="749.4" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k63" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="770.8" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k64" value="Roteiro, atividade, sugestão, orçamento por pessoa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="783.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k65" value="Afinidade: Uso o que a IA me sugere, mas verifico tudo; Tiro ideias de vídeos e lanço-as ao grupo; Tenho orgulho em gastar menos; Os clientes trazem ideias fechadas que nem sempre consigo cumprir" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="798.6" width="288.0" height="40.6" as="geometry"/></mxCell><mxCell id="k66" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="350.0" y="509.0" width="290.0" height="398.8" as="geometry"/></mxCell><mxCell id="k67" value="5. Decidir com o grupo ou o cliente" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="510.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="k68" value="&lt;i&gt;O grupo, ou o cliente do agente, vê a proposta e decide, sem abrir folhas nem pedir prints, e fica registado o que se combinou&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="533.2" width="288.0" height="46.0" as="geometry"/></mxCell><mxCell id="k69" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="583.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k70" value="○ Mostrar ao grupo a ideia e a proposta partilhadas" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="595.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k71" value="● &lt;b&gt;&lt;font color=&quot;#A8461A&quot;&gt;[A]&lt;/font&gt;&lt;/b&gt; Rever a proposta antes de o cliente a ver" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="611.0" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k72" value="○ &lt;b&gt;&lt;font color=&quot;#A8461A&quot;&gt;[A]&lt;/font&gt;&lt;/b&gt; Mostrar a proposta com o logótipo da agência" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="626.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k73" value="○ Mostrar ao grupo o que foi cortado e porquê" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="641.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k74" value="● Indicar as datas possíveis de cada amigo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="657.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k75" value="● Dar a opinião sobre cada opção" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="672.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k76" value="● Definir um prazo para o grupo decidir" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="688.0" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k77" value="○ Avisar o grupo quando o preço sobe" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="703.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k78" value="● Registar o que ficou combinado" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="718.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k79" value="● Partilhar o plano com quem não vai (p. ex. a família)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="734.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k80" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="753.6" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k81" value="&amp;gt; Explorar ideias (1), para refazer a pesquisa com novas datas" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="766.0" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k82" value="&amp;gt; Pagamentos do grupo (6)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="784.4" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k83" value="&amp;gt; Reservar no site ou portal do fornecedor (E)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="802.8" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k84" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="824.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k85" value="Ideia, proposta, opinião, datas possíveis, decisão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="836.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k86" value="Afinidade: Espero pelo grupo e entretanto o preço sobe; A proposta que partilho não chega aos meus amigos; Adianto o dinheiro e cobro depois; Copio à mão de um sistema para outro; Esperam que a IA faça parte do meu trabalho, mas ela engana" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="852.0" width="288.0" height="50.8" as="geometry"/></mxCell><mxCell id="k87" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="670.0" y="509.0" width="290.0" height="314.4" as="geometry"/></mxCell><mxCell id="k88" value="6. Pagamentos do grupo" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="510.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="k89" value="&lt;i&gt;O organizador sabe quem já pagou a sua parte, sem ter de controlar isso de cabeça&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="533.2" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="k90" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="571.2" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k91" value="● Combinar como e quando cada um paga" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="583.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k92" value="○ Calcular a parte de cada um" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="599.0" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k93" value="○ Mostrar a parte de cada um antes de reservar" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="614.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k94" value="● Registar que um membro já pagou (organizador)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="629.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k95" value="○ Mostrar quem já pagou e quem falta" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="645.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k96" value="○ Lembrar quem ainda não pagou" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="660.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k97" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="680.0" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k98" value="Membro do grupo, parte de cada um, registo de pagamento" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="692.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k99" value="Restrições" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="711.8" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k100" value="■ A app não processa pagamentos: só regista quem já pagou" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="724.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k101" value="■ Só o organizador regista pagamentos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="739.6" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k102" value="Questões em aberto" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="759.0" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k103" value="&lt;span style=&quot;color:#6b3fa0&quot;&gt;- O organizador continua a adiantar o dinheiro da reserva; esta área só controla quem pagou&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="771.4" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k104" value="Afinidade: Adianto o dinheiro e cobro depois" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="798.2" width="288.0" height="20.2" as="geometry"/></mxCell><mxCell id="k105" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#A8461A;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="962.8" width="290.0" height="288.6" as="geometry"/></mxCell><mxCell id="k106" value="7. Os meus clientes &lt;b&gt;&lt;font color=&quot;#A8461A&quot;&gt;[A]&lt;/font&gt;&lt;/b&gt;" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="963.8" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="k107" value="&lt;i&gt;O agente vê num só sítio o quadro de cada cliente e o que está pendente em cada um&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="987.0" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="k108" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="1025.0" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k109" value="● Abrir o quadro de um cliente" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1037.4" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k110" value="● Criar um quadro para um cliente novo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1052.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k111" value="○ Mostrar o que está pendente em cada quadro (pedidos novos, propostas por enviar)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1068.2" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="k112" value="● Deixar um lembrete num quadro (ex.: «ligar ao cliente X»)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1095.0" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k113" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="1114.4" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k114" value="&amp;gt; Explorar ideias (1), para um cliente novo" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1126.8" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k115" value="&amp;gt; Decidir com o grupo ou o cliente (5)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1145.2" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="k116" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="1166.6" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k117" value="Cliente, quadro do cliente, lembrete" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1179.0" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k118" value="Restrições" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="1198.4" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="k119" value="■ Só na versão para agências" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="1210.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="k120" value="Afinidade: Copio à mão de um sistema para outro" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="1226.2" width="288.0" height="20.2" as="geometry"/></mxCell><mxCell id="k121" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="670.0" y="962.8" width="290.0" height="76.4" as="geometry"/></mxCell><mxCell id="k122" value="&lt;span style=&quot;font-size:8.5px;color:#777777&quot;&gt;ÁREA EXTERNA&lt;/span&gt;&lt;br&gt;E. Site ou portal do fornecedor" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="963.8" width="288.0" height="36.4" as="geometry"/></mxCell><mxCell id="k123" value="&lt;i&gt;Onde o organizador, ou o agente no portal, reserva e paga. O Roamly não faz reservas.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="1000.2" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="k124" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.056;entryDx=0;entryDy=0;" edge="1" parent="1" source="k10" target="k17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336.0" y="294.9"/><mxPoint x="336.0" y="108.0"/></Array></mxGeometry></mxCell><mxCell id="k125" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.050;entryDx=0;entryDy=0;" edge="1" parent="1" source="k11" target="k66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336.0" y="313.3"/><mxPoint x="336.0" y="529.0"/></Array></mxGeometry></mxCell><mxCell id="k126" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.080;entryDx=0;entryDy=0;" edge="1" parent="1" source="k27" target="k34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="656.0" y="298.9"/><mxPoint x="656.0" y="108.0"/></Array></mxGeometry></mxCell><mxCell id="k127" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.138;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k44" target="k48"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="967.0" y="252.7"/><mxPoint x="967.0" y="493.0"/><mxPoint x="70.0" y="493.0"/></Array></mxGeometry></mxCell><mxCell id="k128" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.050;entryDx=0;entryDy=0;" edge="1" parent="1" source="k62" target="k66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336.0" y="758.1"/><mxPoint x="336.0" y="529.0"/></Array></mxGeometry></mxCell><mxCell id="k129" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.138;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k81" target="k1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="647.0" y="774.7"/><mxPoint x="647.0" y="72.0"/><mxPoint x="70.0" y="72.0"/></Array></mxGeometry></mxCell><mxCell id="k130" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.064;entryDx=0;entryDy=0;" edge="1" parent="1" source="k82" target="k87"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="656.0" y="793.1"/><mxPoint x="656.0" y="529.0"/></Array></mxGeometry></mxCell><mxCell id="k131" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.262;entryDx=0;entryDy=0;" edge="1" parent="1" source="k83" target="k121"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="656.0" y="811.5"/><mxPoint x="656.0" y="982.8"/></Array></mxGeometry></mxCell><mxCell id="k132" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.055;entryDx=0;entryDy=0;" edge="1" parent="1" source="k114" target="k1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="18.0" y="1135.5"/><mxPoint x="18.0" y="108.0"/></Array></mxGeometry></mxCell><mxCell id="k133" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.241;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="k115" target="k66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420.0" y="1153.9"/><mxPoint x="420.0" y="907.8"/></Array></mxGeometry></mxCell><mxCell id="k134" value="User Environment Design: Viajante e agente de viagens" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=19;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="22.8" as="geometry"/></mxCell><mxCell id="k135" value="Áreas de foco do Roamly, a partir do diagrama de afinidade. O agente usa as mesmas áreas que o organizador, a trabalhar para um cliente em vez de um grupo; &lt;b&gt;&lt;font color=&quot;#A8461A&quot;&gt;[A]&lt;/font&gt;&lt;/b&gt; = só na versão para agências." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="44.8" width="956.0" height="26.4" as="geometry"/></mxCell><mxCell id="k136" value="&lt;b&gt;Legenda&lt;/b&gt; &amp;nbsp; caixa = área de foco (um «lugar» do sistema que apoia uma atividade) &amp;nbsp;·&amp;nbsp; ● função que o utilizador invoca &amp;nbsp;·&amp;nbsp; ○ função automática (o sistema faz sozinho) &amp;nbsp;·&amp;nbsp; &amp;gt; ligação: o utilizador passa para outra área (seta) &amp;nbsp;·&amp;nbsp; &amp;gt;&amp;gt; ligação dupla: trabalha numa área no contexto da outra (═) &amp;nbsp;·&amp;nbsp; ■ restrição &amp;nbsp;·&amp;nbsp; caixa cinzenta = área externa (feita fora do Roamly) &amp;nbsp;·&amp;nbsp; Afinidade: grupos do diagrama de afinidade de onde vem a área &amp;nbsp;·&amp;nbsp; a roxo: questões em aberto &amp;nbsp;·&amp;nbsp; &lt;b&gt;&lt;font color=&quot;#A8461A&quot;&gt;[A]&lt;/font&gt;&lt;/b&gt; função ou área só na versão para agências (agente)" style="rounded=0;fillColor=#fafafa;strokeColor=#bbbbbb;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="22.0" y="1277.4" width="956.0" height="50.2" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>