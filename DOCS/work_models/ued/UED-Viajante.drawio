4;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="670.0" y="88.0" width="290.0" height="250.7" as="geometry"/></mxCell><mxCell id="c50" value="4. Roteiro" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="488.2" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="c51" value="&lt;i&gt;Montar os dias da viagem com sugestões verificadas&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="511.4" width="288.0" height="22.0" as="geometry"/></mxCell><mxCell id="c52" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="537.4" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c53" value="○ Mostrar quanto sobra do orçamento por pessoa para atividades" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="549.8" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="c54" value="● Pedir à IA um roteiro que caiba no que sobra" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="576.5" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c55" value="● Juntar atividades e sítios do criador de conteúdo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="591.9" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c56" value="● Ver as atividades no mapa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="607.3" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c57" value="○ Mostrar a fonte de cada sugestão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="622.7" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c58" value="● Marcar uma sugestão como confirmada ou descartada" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="638.1" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c59" value="○ Mostrar o custo de cada atividade" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="653.5" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c60" value="● Cortar uma atividade e ver quanto sobra" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="668.9" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c61" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="688.3" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c62" value="&amp;gt; Decidir com o grupo (5)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="700.7" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="c63" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="37.0" y="722.1" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c64" value="Roteiro, atividade, sugestão, orçamento por pessoa" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="37.0" y="734.5" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c65" value="Afinidade: Uso o que a IA me sugere, mas verifico tudo; Tiro ideias de vídeos e lanço-as ao grupo; Tenho orgulho em gastar menos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="31.0" y="749.8" width="288.0" height="30.4" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="30.0" y="487.2" width="290.0" height="298.0" as="geometry"/></mxCell><mxCell id="c67" value="5. Decidir com o grupo" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="488.2" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="c68" value="&lt;i&gt;O grupo vê a proposta e decide, sem abrir folhas nem pedir prints, e fica registado o que se combinou&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="511.4" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="c69" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="549.4" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c70" value="○ Mostrar ao grupo a ideia e a proposta partilhadas" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="561.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c71" value="○ Mostrar ao grupo o que foi cortado e porquê" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="577.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c72" value="● Indicar as datas possíveis de cada amigo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="592.5" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c73" value="● Dar a opinião sobre cada opção" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="607.9" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c74" value="● Definir um prazo para o grupo decidir" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="623.3" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c75" value="○ Avisar o grupo quando o preço sobe" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="638.7" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c76" value="● Registar o que ficou combinado" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="654.1" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c77" value="● Partilhar o plano com quem não vai (p. ex. a família)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="669.5" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c78" value="Ligações" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="688.9" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c79" value="&amp;gt; Explorar ideias (1), para refazer a pesquisa com novas datas" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="701.3" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="c80" value="&amp;gt; Pagamentos do grupo (6)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="719.7" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="c81" value="&amp;gt; Reservar no site do fornecedor (E)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="738.1" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="c82" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="759.5" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c83" value="Ideia, proposta, opinião, datas possíveis, decisão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="771.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c84" value="Afinidade: Espero pelo grupo e entretanto o preço sobe; A proposta que partilho não chega aos meus amigos; Adianto o dinheiro e cobro depois" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="787.2" width="288.0" height="30.4" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="350.0" y="487.2" width="290.0" height="335.4" as="geometry"/></mxCell><mxCell id="c86" value="6. Pagamentos do grupo" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="488.2" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="c87" value="&lt;i&gt;O organizador sabe quem já pagou a sua parte, sem ter de controlar isso de cabeça&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="511.4" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="c88" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="549.4" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c89" value="● Combinar como e quando cada um paga" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="561.8" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c90" value="○ Calcular a parte de cada um" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="577.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c91" value="○ Mostrar a parte de cada um antes de reservar" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="592.5" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c92" value="● Registar que um membro já pagou (organizador)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="607.9" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c93" value="○ Mostrar quem já pagou e quem falta" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="623.3" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c94" value="○ Lembrar quem ainda não pagou" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="638.7" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c95" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="658.1" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c96" value="Membro do grupo, parte de cada um, registo de pagamento" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="670.5" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c97" value="Restrições" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="689.9" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c98" value="■ A app não processa pagamentos: só regista quem já pagou" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="702.3" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c99" value="■ Só o organizador regista pagamentos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="717.7" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c100" value="Questões em aberto" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="677.0" y="737.1" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c101" value="&lt;span style=&quot;color:#6b3fa0&quot;&gt;- O organizador continua a adiantar o dinheiro da reserva; esta área só controla quem pagou&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="677.0" y="749.5" width="276.0" height="26.8" as="geometry"/></mxCell><mxCell id="c102" value="Afinidade: Adianto o dinheiro e cobro depois" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="776.2" width="288.0" height="20.2" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="670.0" y="487.2" width="290.0" height="314.2" as="geometry"/></mxCell><mxCell id="c104" value="&lt;span style=&quot;font-size:8.5px;color:#777777&quot;&gt;ÁREA EXTERNA&lt;/span&gt;&lt;br&gt;E. Site do fornecedor" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="878.6" width="288.0" height="36.4" as="geometry"/></mxCell><mxCell id="c105" value="&lt;i&gt;Onde o organizador reserva e paga. O Roamly não faz reservas.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="915.0" width="288.0" height="34.0" as="geometry"/></mxCell><mxCell id="c103" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="670.0" y="877.6" width="290.0" height="76.4" as="geometry"/></mxCell><mxCell id="c106" value="&lt;b&gt;Legenda&lt;/b&gt; &amp;nbsp; caixa = área de foco (um «lugar» do sistema que apoia uma atividade) &amp;nbsp;·&amp;nbsp; ● função que o utilizador invoca &amp;nbsp;·&amp;nbsp; ○ função automática (o sistema faz sozinho) &amp;nbsp;·&amp;nbsp; &amp;gt; ligação: o utilizador passa para outra área (seta) &amp;nbsp;·&amp;nbsp; &amp;gt;&amp;gt; ligação dupla: trabalha numa área no contexto da outra (═) &amp;nbsp;·&amp;nbsp; ■ restrição &amp;nbsp;·&amp;nbsp; caixa cinzenta = área externa (feita fora do Roamly) &amp;nbsp;·&amp;nbsp; Afinidade: grupos do diagrama de afinidade de onde vem a área &amp;nbsp;·&amp;nbsp; a roxo: questões em aberto" style="rounded=0;fillColor=#fafafa;strokeColor=#bbbbbb;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=7;" vertex="1" parent="1"><mxGeometry x="22.0" y="980.0" width="956.0" height="50.2" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.063;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336.0" y="283.4"/><mxPoint x="336.0" y="108.0"/></Array></mxGeometry></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.060;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c66"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336.0" y="301.8"/><mxPoint x="336.0" y="507.2"/></Array></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.000;entryY=0.080;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="656.0" y="272.0"/><mxPoint x="656.0" y="108.0"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.138;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c45" target="c49"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="967.0" y="252.6"/><mxPoint x="967.0" y=