eometry x="357.0" y="250.9" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c28" value="&amp;gt; Orçamento da viagem (3)" style="rounded=0;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="263.3" width="276.0" height="17.4" as="geometry"/></mxCell><mxCell id="c29" value="Objetos" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="284.7" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c30" value="Opção de voo, opção de alojamento" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="297.1" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c31" value="Restrições" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#2b4c7e;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="357.0" y="316.5" width="276.0" height="11.4" as="geometry"/></mxCell><mxCell id="c32" value="■ Não usar mensagens de urgência para pressionar a decisão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="328.9" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c33" value="■ O Roamly não faz reservas: mostra as opções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="357.0" y="344.2" width="276.0" height="15.4" as="geometry"/></mxCell><mxCell id="c34" value="Afinidade: Os extras só aparecem quando vou pagar; O custo de chegar ao aeroporto fica fora das minhas contas; Sinto pressão para decidir depressa; Não pago taxa se o site não cobra" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=8.5;fontColor=#777777;fontStyle=2;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="351.0" y="359.6" width="288.0" height="40.6" as="geometry"/></mxCell><mxCell id="c19" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#ffffff;strokeColor=#444444;strokeWidth=1.2;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="350.0" y="88.0" width="290.0" height="317.2" as="geometry"/></mxCell><mxCell id="c36" value="3. Orçamento da viagem" style="rounded=0;fillColor=#eeeeee;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="89.0" width="288.0" height="23.2" as="geometry"/></mxCell><mxCell id="c37" value="&lt;i&gt;Ver o custo real por pessoa num só sítio&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="671.0" y="112.2" width="288.0" height="22.0" as="geometry"/></mxCell><mxCell id="c38" value="Funções" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.