<mxfile host="drawio" type="device"><diagram name="SeqConsolidado" id="SeqConsolidado"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="2585" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Sequence model consolidado: planear uma viagem" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="24.0" as="geometry"/></mxCell><mxCell id="c2" value="Junta a sequência do viajante (U0, organizador de um grupo) e a sequência 3 do agente (A0, casal ao balcão): as duas fazem a mesma tarefa, chegar a uma viagem que funcione. Cada passo abstrato mostra, por baixo, o passo real de U0 e de A0, pela ordem em que aconteceu." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="48.0" width="956.0" height="30.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="89.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="c4" value="Trigger" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="71.0" y="92.0" width="31.3" height="12.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116.3" y="90.0" width="34.0" height="16.0" as="geometry"/></mxCell><mxCell id="c6" value="Passo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="155.3" y="92.0" width="27.8" height="12.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rhombus;fillColor=#fdeeb5;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="197.1" y="88.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c8" value="Decisão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="242.1" y="92.0" width="36.1" height="12.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="292.2" y="89.5" width="10.0" height="17.0" as="geometry"/></mxCell><mxCell id="c10" value="Breakdown" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="307.2" y="92.0" width="50.0" height="12.0" as="geometry"/></mxCell><mxCell id="c11" value="- - - &amp;gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="371.3" y="91.4" width="30.0" height="13.2" as="geometry"/></mxCell><mxCell id="c12" value="Loop" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="406.3" y="92.0" width="22.2" height="12.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;i&gt;Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="112.0" width="956.0" height="11.4" as="geometry"/></mxCell><mxCell id="c14" value="&lt;span style=&quot;font-size:10px;font-weight:bold;color:#2b4c7e&quot;&gt;Primary intent&lt;/span&gt;&lt;br&gt;Chegar a uma viagem que funcione e que caiba no que quem viaja quer gastar.&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#777777&quot;&gt;U0 (SeqU0): Planear uma viagem barata que todo o grupo aceite, até 300 € por pessoa · A0 (SeqA0, seq. 3): Dar ao casal uma viagem que funcione, sob a forma de proposta&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="22.0" y="137.4" width="956.0" height="64.8" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Surge uma ideia ou um pedido de viagem&lt;br&gt;&lt;span style=&quot;font-size:9.5px&quot;&gt;– inspiração vinda de fora (U0: vídeo «Cracóvia por 150 €», UE01)&lt;br&gt;– o cliente traz um pedido ao balcão (A0: casal com roteiro impresso, AE03)&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="232.2" width="270.0" height="108.8" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;1. Receber a ideia ou o pedido&lt;/span&gt;&lt;br&gt;&lt;br&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="232.2" width="293.0" height="30.0" as="geometry"/></mxCell><mxCell id="c17" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="218.2" width="976.0" height="136.8" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Levar a ideia a quem vai viajar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; cria um grupo de mensagens com o Amigo A e o Amigo B e envia o vídeo: «bora?» (UE01)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="383.0" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Saber o orçamento, as datas e o que não se abdica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; Amigo B: «depende do preço; era mais fácil perto do fim de semana» (UE02)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; pergunta o orçamento, as datas flexíveis e «o que não abdicam» (AE03)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="466.3" width="320.0" height="85.0" as="geometry"/></mxCell><mxCell id="c20" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="495.6" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c21" value="O roteiro não diz o orçamento, as datas flexíveis nem «o que não abdicam»: A0 tem de perguntar (A0-06)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="495.6" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;2. Perceber o que quem viaja quer&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Perceber o que quem viaja quer e até onde é flexível&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="383.0" width="293.0" height="58.8" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="369.0" width="976.0" height="196.4" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Ver as opções de voo e alojamento&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; abre o comparador de voos com datas «mês inteiro» e compara três combinações de datas (UE03, UE04)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; lê o roteiro: ideias, voos e sítios onde gostariam de ficar (AE03, AE04)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="593.3" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Comparar alojamentos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; compara dormitório (14 €/noite) e quarto privado para 3 (UE05)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="690.5" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Quem viaja dá a opinião&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; Amigo A, no grupo: «dormitório não»; fica com o quarto privado (UE05)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="760.1" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c27" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;3. Ver as opções&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Encontrar opções baratas que quem viaja aceite&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="593.3" width="293.0" height="58.8" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="579.3" width="976.0" height="238.4" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Verificar a logística: horários, distâncias, transportes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; hesita ≈20 s no voo mais barato (6h50): «Como é que chego ao aeroporto às cinco da manhã?» (UE04)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; mostra que duas cidades ficam a 6 h de comboio e que um monumento fecha no dia previsto (AE04)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="845.7" width="320.0" height="85.0" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="861.8" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c31" value="O voo mais barato obriga a chegar ao aeroporto de madrugada, sem transporte (U0-06)&lt;br&gt;Logística inviável: A0 tem de desfazer o roteiro que o casal trouxe e o casal fica desagradado (A0-05)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="861.8" width="283.0" height="52.8" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Escolher uma opção viável&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; escolhe o voo das 11h30 (UE04)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; — (não registado)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="956.7" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Quem viaja reage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; o casal troca olhares, desagradado (AE04)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1040.1" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c34" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;4. Verificar se a viagem funciona&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Garantir que a viagem é possível na prática&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="845.7" width="293.0" height="58.8" as="geometry"/></mxCell><mxCell id="c35" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="831.7" width="976.0" height="266.0" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Partir de um molde&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; duplica a folha de cálculo da viagem anterior («já tem as colunas que uso») (UE06)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; usa o modelo da agência (documento com logótipo) (AE05)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1125.7" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Copiar os dados de outros sistemas para a proposta&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; copia à mão os preços de cada site: total 303 € por pessoa, acima dos 300 € (UE06)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; copia dados do portal para o modelo da agência (AE05)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1222.9" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c38" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1232.1" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c39" value="Custo real espalhado: comparador, transporte até ao aeroporto, folha de cálculo (U0-07)&lt;br&gt;Procurar e copiar dados à mão entre sistemas: «grande parte da manhã» (fecho, A0-07)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1232.1" width="283.0" height="52.8" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Ver o custo real&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; na página de pagamento do voo surge a bagagem de porão (+34 €); decide levar só mochila pequena (UE07)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1320.0" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c41" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1335.5" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c42" value="Custo escondido que só aparece no pagamento: «isto ninguém diz» (U0-08)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1335.5" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c43" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;5. Juntar tudo numa proposta&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ter depressa uma proposta cujo total por pessoa caiba no orçamento&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1125.7" width="293.0" height="73.2" as="geometry"/></mxCell><mxCell id="c44" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1111.7" width="976.0" height="279.8" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Levar a proposta a quem decide&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; — (só partilha a folha depois de reservar: ver 9, UE17)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; diz que envia a proposta por email «o mais rápido possível» (AE05)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1419.4" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Quem decide não decide logo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; dois dias sem resposta do grupo; o voo sobe 19 €; envia «malta, subiu» (UE08)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#8a3a16&quot;&gt;&lt;b&gt;A0:&lt;/b&gt; o casal agradece e diz que vai «pensar e comparar online» (AE06)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1502.8" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1528.9" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c48" value="O grupo responde devagar e o preço sobe (U0-09)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1528.9" width="283.0" height="13.2" as="geometry"/></mxCell><mxCell id="c49" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;6. Levar a proposta a quem decide&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Conseguir uma decisão de quem viaja antes que o preço mude&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1419.4" width="293.0" height="73.2" as="geometry"/></mxCell><mxCell id="c50" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1405.4" width="976.0" height="182.6" as="geometry"/></mxCell><mxCell id="c51" value="Quem planeia também fecha a viagem?" style="rhombus;fillColor=#fdeeb5;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="365.0" y="1616.0" width="270.0" height="86.0" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;A0 envia a proposta e o cliente decide sozinho&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px&quot;&gt;o casal vai «pensar e comparar online» (AE06, A0-08)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="685.0" y="1638.4" width="280.0" height="41.2" as="geometry"/></mxCell><mxCell id="c53" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;Duas estratégias&lt;/span&gt;&lt;br&gt;&lt;br&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1616.0" width="293.0" height="30.0" as="geometry"/></mxCell><mxCell id="c54" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1602.0" width="976.0" height="114.0" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;Refazer quando uma condição muda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; Amigo B só confirma que pode a partir de uma sexta concreta; refaz a pesquisa com as novas datas: total 322 € (UE09)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1744.0" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;Juntar ideias e verificá-las&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; pede ao ChatGPT um «roteiro de 4 dias em Cracóvia, barato»; verifica no mapa: confirma 2 e descarta 1; acrescenta o sítio do vídeo à lista do mapa (UE10, UE11)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1827.4" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c57" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1849.8" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c58" value="Não sabe se o que a IA sugere é verdade: tem de verificar cada item no mapa (UE10, U0-14)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1849.8" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Cortar o que não cabe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; risca a visita à mina de sal (28 €, «isto é para turistas»): total 294 € (UE12)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1924.6" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c60" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;7. Ajustar a viagem&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Voltar a encaixar a viagem no orçamento e no grupo, só com o que é verdade&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1744.0" width="293.0" height="73.2" as="geometry"/></mxCell><mxCell id="c61" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1730.0" width="976.0" height="266.0" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Dizer a quem precisa de saber&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; no domingo anterior, a mãe ao telefone: «manda-me onde vais dormir»; envia-lhe a ligação do alojamento (UE13)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2024.0" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Decidir quando fechar, sem ceder à pressão&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; aparece o aviso «só restam 2 quartos!»: «isto é para me pressionar»; fecha o separador e abre outro site para comparar (UE14)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2107.4" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;Reservar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; reserva o voo dos três com o seu cartão de débito; alojamento a pagar no local, com pequena caução (UE15)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2190.8" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c65" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="2206.3" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c66" value="U0 adianta o dinheiro de todos (fecho: «e ter de adiantar eu o dinheiro»; U0-16)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="2206.3" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c67" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;8. Fechar a viagem&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Fechar a viagem sem ceder à pressão, com quem precisa de saber a par&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="2024.0" width="293.0" height="73.2" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="2010.0" width="976.0" height="252.2" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;Cobrar a parte de cada um&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; pede 98 € por MB Way a cada amigo; Amigo A paga em minutos, Amigo B: «só no fim do mês» (UE16)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2290.2" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c70" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="2309.3" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c71" value="O Amigo B paga com atraso (U0-16)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="2309.3" width="283.0" height="13.2" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;Pôr o grupo a par das contas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; partilha a ligação da folha no grupo; Amigo A: «manda print»; envia uma captura de ecrã da folha (UE17)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2373.5" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c73" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="2392.7" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c74" value="Ninguém abre a folha partilhada (U0-18)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="2392.7" width="283.0" height="13.2" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Escolher o resto em conjunto e registá-lo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#1f5f5a&quot;&gt;&lt;b&gt;U0:&lt;/b&gt; na semana seguinte, no café, o grupo escolhe as atividades numa aplicação, com um telemóvel passado de mão em mão; depois U0 regista «o que combinámos» (UE18)&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2456.9" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c76" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="2472.8" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c77" value="No café ninguém tomou nota do que se decidia; U0 registou depois, nas notas, «o que combinámos» (UE18, U0-19)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="2472.8" width="283.0" height="39.6" as="geometry"/></mxCell><mxCell id="c78" value="&lt;span style=&quot;font-size:13px;font-weight:bold&quot;&gt;9. Acertar contas e escolher o resto&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Acertar contas e decisões com o grupo e ficar com registo&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="2290.2" width="293.0" height="73.2" as="geometry"/></mxCell><mxCell id="c79" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="2276.2" width="976.0" height="266.0" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundColor=none;align=left;verticalAlign=top;spacingLeft=4;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundColor=none;align=left;verticalAlign=top;spacingLeft=4;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundColor=none;align=left;verticalAlign=top;spacingLeft=4;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundColor=none;align=left;verticalAlign=top;spacingLeft=4;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundColor=n