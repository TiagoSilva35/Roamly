<mxfile host="drawio" type="device"><diagram name="SeqU0" id="SeqU0"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="4138" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Sequence model: U0 (organizador(a) do grupo)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="24.0" as="geometry"/></mxCell><mxCell id="c2" value="Viagem: 4 noites em Cracóvia com o Amigo A e o Amigo B. Limite: 300 € por pessoa, tudo incluído. U0 mostra, passo a passo, como planeou a viagem." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="48.0" width="956.0" height="15.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="74.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="c4" value="Trigger" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="71.0" y="77.0" width="31.3" height="12.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116.3" y="75.0" width="34.0" height="16.0" as="geometry"/></mxCell><mxCell id="c6" value="Passo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="155.3" y="77.0" width="27.8" height="12.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rhombus;fillColor=#fdeeb5;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="197.1" y="73.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c8" value="Decisão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="242.1" y="77.0" width="36.1" height="12.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="292.2" y="74.5" width="10.0" height="17.0" as="geometry"/></mxCell><mxCell id="c10" value="Breakdown" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="307.2" y="77.0" width="50.0" height="12.0" as="geometry"/></mxCell><mxCell id="c11" value="- - - &amp;gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="371.3" y="76.4" width="30.0" height="13.2" as="geometry"/></mxCell><mxCell id="c12" value="Loop" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="406.3" y="77.0" width="22.2" height="12.0" as="geometry"/></mxCell><mxCell id="c13" value="Intervalo de tempo" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=center;verticalAlign=middle;spacing=3;" vertex="1" parent="1"><mxGeometry x="442.5" y="73.3" width="112.0" height="19.4" as="geometry"/></mxCell><mxCell id="c14" value="o trabalho para e é retomado mais tarde por outro trigger (sem seta)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="559.5" y="77.0" width="302.4" height="12.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;i&gt;Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="97.0" width="956.0" height="11.4" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style=&quot;font-size:10px;font-weight:bold;color:#2b4c7e&quot;&gt;Primary intent&lt;/span&gt;&lt;br&gt;Planear uma viagem barata que todo o grupo aceite, até 300 € por pessoa." style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=13;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="22.0" y="122.4" width="956.0" height="49.2" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style=&quot;font-size:10px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intents (toda a sequência)&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0&quot;&gt;• Gastar o mínimo, mas com escolhas que os amigos aceitem (fecho: «sempre a pensar nos amigos»)&lt;br&gt;• Decidir sem ser pressionado(a): «isto é para me pressionar» (UE14, U0-10)&lt;/i&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#ffffff;strokeColor=#6b3fa0;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="22.0" y="179.6" width="956.0" height="61.2" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;À noite, no sofá, no telemóvel, U0 vê um vídeo de uma rede social: «Cracóvia por 150 €»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE01&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="270.8" width="270.0" height="81.2" as="geometry"/></mxCell><mxCell id="c19" value="Guarda o vídeo&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE01&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="377.9" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c20" value="Cria um grupo de mensagens com o Amigo A e o Amigo B e envia o vídeo: «bora?»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE01&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="447.5" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c21" value="Amigo A responde de imediato. Amigo B: «depende do preço; era mais fácil perto do fim de semana»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE02&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="530.9" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Convencer os amigos a ir&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="270.8" width="293.0" height="28.8" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="256.8" width="976.0" height="345.6" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Intervalo de tempo&lt;/b&gt; · outro momento: «terça à noite»" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#444444;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="160.0" y="616.3" width="680.0" height="24.6" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Terça à noite&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE03&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="670.9" width="270.0" height="67.4" as="geometry"/></mxCell><mxCell id="c26" value="Abre o comparador de voos: origem «aeroporto mais próximo» («não há aeroporto na minha cidade»), destino Cracóvia, datas «mês inteiro»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE03&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="764.3" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c27" value="Compara três combinações de datas&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE04&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="861.5" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c28" value="Hesita ≈20 s no voo mais barato (6h50): «Como é que chego ao aeroporto às cinco da manhã?» Pesquisa comboio + metro (≈13 € por sentido) e autocarro (8 €, mais 1 h)&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE04&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="931.1" width="320.0" height="85.0" as="geometry"/></mxCell><mxCell id="c29" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="960.4" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c30" value="O voo mais barato obriga a chegar ao aeroporto de madrugada, sem transporte (U0-06)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="960.4" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c31" value="Consegue chegar ao aeroporto às 5 h?" style="rhombus;fillColor=#fdeeb5;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="365.0" y="1042.1" width="270.0" height="86.0" as="geometry"/></mxCell><mxCell id="c32" value="Escolhe o voo das 11h30&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE04&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1154.1" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c33" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Encontrar um voo barato a que U0 consiga chegar&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Deixar que o preço escolha as datas (U0-05)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="670.9" width="293.0" height="72.0" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="656.9" width="976.0" height="554.8" as="geometry"/></mxCell><mxCell id="c35" value="Compara dormitório (14 €/noite) e quarto privado para 3 (24 € por pessoa e noite)&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE05&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1239.7" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c36" value="Amigo A, no grupo: «dormitório não»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE05&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1323.0" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c37" value="Fica com o quarto privado&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE05&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1392.6" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c38" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Encontrar um sítio barato que o grupo aceite&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Que os amigos aceitem o sítio, e não só o preço (fecho)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1239.7" width="293.0" height="72.0" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1225.7" width="976.0" height="224.6" as="geometry"/></mxCell><mxCell id="c40" value="Duplica a folha de cálculo da viagem anterior («já tem as colunas que uso»)&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE06&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1478.2" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c41" value="Copia à mão os preços de cada site: total 303 € por pessoa, acima dos 300 €&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE06&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1561.6" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c42" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1570.5" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c43" value="Custo real espalhado: comparador, transporte até ao aeroporto, folha de cálculo. O transporte até ao aeroporto não tem lugar na folha (U0-07)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1570.5" width="283.0" height="39.6" as="geometry"/></mxCell><mxCell id="c44" value="Na página de pagamento do voo surge a bagagem de porão (+34 €)&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE07&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1645.0" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c45" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1660.5" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c46" value="Custo escondido que só aparece no pagamento: «isto ninguém diz» (U0-08)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1660.5" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c47" value="Decide levar só mochila pequena&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE07&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1728.4" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c48" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Ver se cabe nos 300 € por pessoa&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Não começar as contas do zero (U0-04)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Decidir sempre pelo total por pessoa (UE06)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1478.2" width="293.0" height="86.3" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1464.2" width="976.0" height="321.8" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Intervalo de tempo&lt;/b&gt; · dois dias sem resposta do grupo" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#444444;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="160.0" y="1800.0" width="680.0" height="24.6" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Dois dias sem resposta do grupo&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE08&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="1854.6" width="270.0" height="67.4" as="geometry"/></mxCell><mxCell id="c52" value="Volta ao comparador: o voo subiu 19 €&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE08&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1948.0" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c53" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1960.3" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c54" value="O grupo responde devagar e o preço sobe (U0-09)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1960.3" width="283.0" height="13.2" as="geometry"/></mxCell><mxCell id="c55" value="Envia ao grupo: «malta, subiu»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE08&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2017.6" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c56" value="Amigo B só confirma que pode a partir de uma sexta concreta&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE09&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2087.2" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c57" value="Refaz a pesquisa com as novas datas: total 322 €&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE09&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2170.6" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c58" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Fechar a viagem antes que o preço mude&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1854.6" width="293.0" height="28.8" as="geometry"/></mxCell><mxCell id="c59" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1840.6" width="976.0" height="387.6" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Intervalo de tempo&lt;/b&gt; · outro momento: «intervalo entre aulas»" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#444444;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="160.0" y="2242.2" width="680.0" height="24.6" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Intervalo entre aulas&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE10&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="2296.8" width="270.0" height="67.4" as="geometry"/></mxCell><mxCell id="c62" value="No telemóvel, pede ao ChatGPT um «roteiro de 4 dias em Cracóvia, barato». Copia 4 itens para as notas: «não sei se isto é verdade, vou ver no mapa»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE10&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2390.1" width="320.0" height="71.2" as="geometry"/></mxCell><mxCell id="c63" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="2412.5" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c64" value="Não sabe se o que a IA sugere é verdade: tem de verificar cada item no mapa (UE10, U0-14)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="2412.5" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c65" value="Verifica no mapa: confirma 2 e descarta 1&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE10&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2487.3" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c66" value="Acrescenta à lista do mapa o sítio de comida de rua recomendado no vídeo&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE11&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2556.9" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c67" value="Risca a visita à mina de sal (28 €, «isto é para turistas»): total 294 €&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE12&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2640.3" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c68" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Voltar a ficar dentro dos 300 €&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Ter ideias de atividades baratas (fecho)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Só contar com o que é verdade (UE10)&lt;/i&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Mostrar ao grupo o que foi cortado e porquê (U0-17)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="2296.8" width="293.0" height="100.7" as="geometry"/></mxCell><mxCell id="c69" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="2282.8" width="976.0" height="429.0" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Intervalo de tempo&lt;/b&gt; · outro dia: «no domingo anterior»" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#444444;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="160.0" y="2725.7" width="680.0" height="24.6" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;No domingo anterior, a mãe ao telefone: «não gastes o que não tens; manda-me onde vais dormir»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE13&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="2780.3" width="270.0" height="95.0" as="geometry"/></mxCell><mxCell id="c72" value="Envia-lhe a ligação do alojamento&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE13&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="2901.3" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c73" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Dizer à mãe onde vai dormir, como ela pediu&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="2780.3" width="293.0" height="28.8" as="geometry"/></mxCell><mxCell id="c74" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="2766.3" width="976.0" height="192.6" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Intervalo de tempo&lt;/b&gt; · momento não registado" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#444444;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="160.0" y="2972.9" width="680.0" height="24.6" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Aparece o aviso «só restam 2 quartos!»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE14&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="3027.5" width="270.0" height="67.4" as="geometry"/></mxCell><mxCell id="c77" value="«isto é para me pressionar»: fecha o separador e abre outro site para comparar&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE14&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3120.9" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c78" value="Reserva o voo dos três com o seu cartão de débito (adianta o dinheiro)&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE15&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3204.2" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c79" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="3219.8" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c80" value="U0 adianta o dinheiro de todos (fecho: «e ter de adiantar eu o dinheiro»; U0-16)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="3219.8" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c81" value="Alojamento a pagar no local, com pequena caução&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE15&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3287.6" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c82" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Garantir o preço antes que suba&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Não se deixar pressionar pelo site (U0-10)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="3027.5" width="293.0" height="72.0" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="3013.5" width="976.0" height="331.8" as="geometry"/></mxCell><mxCell id="c84" value="Pede 98 € por MB Way a cada amigo&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE16&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3373.2" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c85" value="Amigo A paga em minutos&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE16&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3442.8" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c86" value="Amigo B: «só no fim do mês»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE16&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3512.4" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c87" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="3524.7" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c88" value="O Amigo B paga com atraso (U0-16)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="3524.7" width="283.0" height="13.2" as="geometry"/></mxCell><mxCell id="c89" value="Partilha a ligação da folha no grupo&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE17&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3582.0" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c90" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="3594.3" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c91" value="Ninguém abre a folha partilhada (U0-18)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="3594.3" width="283.0" height="13.2" as="geometry"/></mxCell><mxCell id="c92" value="Amigo A: «manda print»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE17&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3651.6" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c93" value="Envia uma captura de ecrã da folha&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE17&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3721.2" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c94" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Reaver o dinheiro e pôr o grupo a par&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Não ficar a perder o dinheiro que adiantou (fecho)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="3373.2" width="293.0" height="72.0" as="geometry"/></mxCell><mxCell id="c95" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="3359.2" width="976.0" height="419.6" as="geometry"/></mxCell><mxCell id="c96" value="&lt;b&gt;Intervalo de tempo&lt;/b&gt; · uma semana: «na semana seguinte»" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#ffffff;strokeColor=#8a8a8a;strokeWidth=1;dashed=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10.5;fontColor=#444444;fontStyle=0;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1"><mxGeometry x="160.0" y="3792.8" width="680.0" height="24.6" as="geometry"/></mxCell><mxCell id="c97" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Na semana seguinte, o grupo encontra-se no café ao lado da faculdade&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE18&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="3847.4" width="270.0" height="81.2" as="geometry"/></mxCell><mxCell id="c98" value="O grupo escolhe as atividades numa aplicação, com um telemóvel passado de mão em mão; ninguém escreve&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE18&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="3954.6" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c99" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="3970.1" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c100" value="No café ninguém escreve o que se decide: U0 tem de o registar depois (U0-19)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="3970.1" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c101" value="Depois, U0 regista nas notas «o que combinámos»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;UE18&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="4038.0" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c102" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Escolher as atividades em conjunto&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Ficar com registo do que foi combinado (U0-19)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="3847.4" width="293.0" height="72.0" as="geometry"/></mxCell><mxCell id="c103" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x=