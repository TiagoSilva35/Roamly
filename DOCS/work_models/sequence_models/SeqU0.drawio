<mxfile host="drawio" type="device"><diagram name="SeqU0" id="SeqU0"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="4041" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="330.1" width="976.0" height="243.0" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="597.1" width="976.0" height="560.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="1181.1" width="976.0" height="227.4" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="1432.5" width="976.0" height="327.9" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="1784.4" width="976.0" height="395.6" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="2204.0" width="976.0" height="458.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="2686.0" width="976.0" height="203.3" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="2913.3" width="976.0" height="341.9" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="3279.2" width="976.0" height="419.7" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;arcSize=2;fillColor=#f2f5fa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="12.0" y="3722.9" width="976.0" height="288.2" as="geometry"/></mxCell><mxCell id="c11" value="Sequence model: U0 (organizador(a) do grupo)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="962.0" height="23.0" as="geometry"/></mxCell><mxCell id="c12" value="Viagem: 4 noites em Cracóvia com o Amigo A e o Amigo B. Limite: 300 € por pessoa, tudo incluído. U0 mostra, passo a passo, como planeou a viagem." style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="45.0" width="962.0" height="14.0" as="geometry"/></mxCell><mxCell id="c13" value="Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista." style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=10;fontColor=#555555;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="22.0" y="165.0" width="962.0" height="11.0" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Convencer os amigos a ir' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="344.1" width="240.0" height="27.0" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Encontrar um voo barato a que U0 consiga chegar&lt;br&gt;&lt;b&gt;&lt;font style="font-size:9.5px" color="#7a4aa8"&gt;Secondary intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#5a2f86"&gt;• Pesquisar por orçamento e datas, não por destino: «mês inteiro» (U0-05)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="611.1" width="240.0" height="80.0" as="geometry"/></mxCell><mxCell id="c18" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Encontrar um sítio barato que o grupo aceite&lt;br&gt;&lt;b&gt;&lt;font style="font-size:9.5px" color="#7a4aa8"&gt;Secondary intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#5a2f86"&gt;• Pensar nos amigos (fecho)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="1195.1" width="240.0" height="56.0" as="geometry"/></mxCell><mxCell id="c19" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ver se cabe nos 300 € por pessoa&lt;br&gt;&lt;b&gt;&lt;font style="font-size:9.5px" color="#7a4aa8"&gt;Secondary intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#5a2f86"&gt;• Partir da folha da viagem anterior em vez de uma folha em branco (U0-04)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="1446.5" width="240.0" height="68.0" as="geometry"/></mxCell><mxCell id="c20" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Fechar a viagem antes que o preço mude' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="1798.4" width="240.0" height="27.0" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Voltar a ficar dentro dos 300 €&lt;br&gt;&lt;b&gt;&lt;font style="font-size:9.5px" color="#7a4aa8"&gt;Secondary intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#5a2f86"&gt;• Ter ideias com a IA e verificá-las no mapa (U0-14)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#5a2f86"&gt;• Justificar ao grupo o que foi cortado (U0-17)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="2218.0" width="240.0" height="92.0" as="geometry"/></mxCell><mxCell id="c22" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Dizer à mãe onde vai dormir, como ela pediu' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="2700.0" width="240.0" height="39.0" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Garantir o preço antes que suba&lt;br&gt;&lt;b&gt;&lt;font style="font-size:9.5px" color="#7a4aa8"&gt;Secondary intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#5a2f86"&gt;• Não se deixar pressionar pelo site (U0-10)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="2927.3" width="240.0" height="56.0" as="geometry"/></mxCell><mxCell id="c24" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Reaver o dinheiro e pôr o grupo a par' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="3293.2" width="240.0" height="27.0" as="geometry"/></mxCell><mxCell id="c25" value='&lt;b&gt;&lt;font style="font-size:9.5px" color="#2a4a9a"&gt;Intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Escolher as atividades em conjunto&lt;br&gt;&lt;b&gt;&lt;font style="font-size:9.5px" color="#7a4aa8"&gt;Secondary intent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;font color="#5a2f86"&gt;• Ficar com registo do que foi combinado (U0-19)&lt;/font&gt;&lt;/i&gt;' style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11.5;fontColor=#1f3a6b;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="3736.9" width="240.0" height="68.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Primary intent&lt;/b&gt;&lt;br&gt;Planear uma viagem barata que todo o grupo aceite, até 300 € por pessoa." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;fillColor=#dbe8fa;gradientColor=#8fb1e3;strokeColor=#5d82bd;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="22.0" y="71.0" width="470.0" height="64.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Secondary intents (toda a sequência)&lt;/b&gt;&lt;br&gt;• Escolher pelo preço, mas sempre a pensar nos amigos (fecho, U0 confirma)&lt;br&gt;• Não ser pressionado(a) a decidir: «isto é para me pressionar» (UE14, U0-10)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;fillColor=#f2eafa;gradientColor=#dcc9f0;strokeColor=#9a72c9;fontSize=12.5;" vertex="1" parent="1"><mxGeometry x="508.0" y="71.0" width="470.0" height="64.0" as="geometry"/></mxCell><mxCell id="x1" value="" style="ellipse;shape=ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;" vertex="1" parent="1"><mxGeometry x="22.0" y="145.5" width="40.0" height="17.0" as="geometry"/></mxCell><mxCell id="x2" value="Trigger" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.6;fontColor=#222222;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="68.0" y="148.5" width="34.0" height="11.0" as="geometry"/></mxCell><mxCell id="x3" value="" style="rounded=0;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;" vertex="1" parent="1"><mxGeometry x="107.0" y="145.5" width="34.0" height="17.0" as="geometry"/></mxCell><mxCell id="x4" value="Passo" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.6;fontColor=#222222;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="147.0" y="148.5" width="30.7" height="11.0" as="geometry"/></mxCell><mxCell id="x5" value="" style="rhombus;shape=rhombus;fillColor=#fde9a8;strokeColor=#d4a72c;" vertex="1" parent="1"><mxGeometry x="182.7" y="145.0" width="36.0" height="18.0" as="geometry"/></mxCell><mxCell id="x6" value="Decisão" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.6;fontColor=#222222;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="224.7" y="148.5" width="38.7" height="11.0" as="geometry"/></mxCell><mxCell id="x7" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="268.4" y="145.0" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="x8" value="Breakdown" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.6;fontColor=#222222;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="285.4" y="148.5" width="52.0" height="11.0" as="geometry"/></mxCell><mxCell id="x9" value="" style="line;shape=line;html=1;fillColor=none;strokeColor=#222222;dashed=1;" vertex="1" parent="1"><mxGeometry x="342.4" y="149.0" width="34.0" height="10.0" as="geometry"/></mxCell><mxCell id="x10" value="Loop" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=9.6;fontColor=#222222;fontStyle=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="382.4" y="148.5" width="25.3" height="11.0" as="geometry"/></mxCell><mxCell id="c26" value='&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;À noite, no sofá, no telemóvel, U0 vê um vídeo de uma rede social: «Cracóvia por 150 €»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE01&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;ellipse;shape=ellipse;perimeter=ellipsePerimeter;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="200.0" width="300.0" height="106.1" as="geometry"/></mxCell><mxCell id="c27" value='Guarda o vídeo&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE01&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="344.1" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c28" value='Cria um grupo de mensagens com o Amigo A e o Amigo B e envia o vídeo: «bora?»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE01&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="413.3" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c29" value='Amigo A responde de imediato. Amigo B: «depende do preço; era mais fácil perto do fim de semana»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE02&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="498.2" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Terça à noite&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE03&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;ellipse;shape=ellipse;perimeter=ellipsePerimeter;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="611.1" width="300.0" height="74.9" as="geometry"/></mxCell><mxCell id="c31" value='Abre o comparador de voos: origem «aeroporto mais próximo» («não há aeroporto na minha cidade»), destino Cracóvia, datas «mês inteiro»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE03&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="710.0" width="300.0" height="76.5" as="geometry"/></mxCell><mxCell id="c32" value='Compara três combinações de datas&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE04&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="810.4" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c33" value='Hesita ≈20 s no voo mais barato (6h50): «Como é que chego ao aeroporto às cinco da manhã?» Pesquisa comboio + metro (≈13 € por sentido) e autocarro (8 €, mais 1 h)&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE04&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="879.7" width="300.0" height="92.1" as="geometry"/></mxCell><mxCell id="c34" value="U0 consegue chegar ao aeroporto às 5 h?" style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rhombus;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fdeeb5;strokeColor=#d4a72c;fontStyle=1;fontSize=11.5;" vertex="1" parent="1"><mxGeometry x="316.0" y="995.8" width="300.0" height="78.0" as="geometry"/></mxCell><mxCell id="c35" value='Escolhe o voo das 11h30&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE04&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1097.8" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c36" value='Compara dormitório (14 €/noite) e quarto privado para 3 (24 € por pessoa e noite)&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE05&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1195.1" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c37" value='Amigo A, no grupo: «dormitório não»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE05&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1279.9" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c38" value='Fica com o quarto privado&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE05&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1349.2" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c39" value='Duplica a folha de cálculo da viagem anterior («já tem as colunas que uso»)&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE06&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1446.5" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c40" value='Copia à mão os preços de cada site: total 303 € por pessoa, acima dos 300 €&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE06&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1531.4" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c41" value='Na página de pagamento do voo surge a bagagem de porão (+34 €)&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE07&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1616.2" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c42" value='Decide levar só mochila pequena&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE07&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1701.1" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c43" value='&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Dois dias sem resposta do grupo&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE08&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;ellipse;shape=ellipse;perimeter=ellipsePerimeter;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1798.4" width="300.0" height="74.9" as="geometry"/></mxCell><mxCell id="c44" value='Volta ao comparador: o voo subiu 19 €&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE08&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1897.3" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c45" value='Envia ao grupo: «malta, subiu»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE08&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="1966.6" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c46" value='Amigo B só confirma que pode a partir de uma sexta concreta&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE09&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2035.8" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c47" value='Refaz a pesquisa com as novas datas: total 322 €&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE09&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2120.7" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c48" value='&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Intervalo entre aulas&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE10&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;ellipse;shape=ellipse;perimeter=ellipsePerimeter;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2218.0" width="300.0" height="74.9" as="geometry"/></mxCell><mxCell id="c49" value='No telemóvel, pede ao ChatGPT um «roteiro de 4 dias em Cracóvia, barato». Copia 4 itens para as notas: «não sei se isto é verdade, vou ver no mapa»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE10&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2316.9" width="300.0" height="92.1" as="geometry"/></mxCell><mxCell id="c50" value='Verifica no mapa: confirma 2 e descarta 1&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE10&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2432.9" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c51" value='Acrescenta à lista do mapa o sítio de comida de rua recomendado no vídeo&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE11&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2502.2" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c52" value='Risca a visita à mina de sal (28 €, «isto é para turistas»): total 294 €&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE12&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2587.1" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c53" value='&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;No domingo anterior, a mãe ao telefone: «não gastes o que não tens; manda-me onde vais dormir»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE13&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;ellipse;shape=ellipse;perimeter=ellipsePerimeter;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2700.0" width="300.0" height="106.1" as="geometry"/></mxCell><mxCell id="c54" value='Envia-lhe a ligação do alojamento&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE13&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2830.0" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c55" value='&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Aparece o aviso «só restam 2 quartos!»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE14&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;ellipse;shape=ellipse;perimeter=ellipsePerimeter;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="2927.3" width="300.0" height="74.9" as="geometry"/></mxCell><mxCell id="c56" value='«isto é para me pressionar»: fecha o separador e abre outro site para comparar&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE14&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3026.2" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c57" value='Reserva o voo dos três com o seu cartão de débito (adianta o dinheiro)&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE15&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3111.1" width="300.0" height="60.9" as="geometry"/></mxCell><mxCell id="c58" value='Alojamento a pagar no local, com pequena caução&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE15&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3195.9" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c59" value='Pede 98 € por MB Way a cada amigo&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE16&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3293.2" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c60" value='Amigo A paga em minutos&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE16&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3362.5" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c61" value='Amigo B: «só no fim do mês»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE16&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3431.8" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c62" value='Partilha a ligação da folha no grupo&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE17&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3501.1" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c63" value='Amigo A: «manda print»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE17&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3570.3" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c64" value='Envia uma captura de ecrã da folha&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE17&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3639.6" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c65" value='&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Na semana seguinte, o grupo encontra-se no café ao lado da faculdade&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE18&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;ellipse;shape=ellipse;perimeter=ellipsePerimeter;fillColor=#d4e3f8;gradientColor=#7fa5df;strokeColor=#5b7fb8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3736.9" width="300.0" height="90.5" as="geometry"/></mxCell><mxCell id="c66" value='O grupo escolhe as atividades numa aplicação, com um telemóvel passado de mão em mão; ninguém escreve&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE18&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3851.4" width="300.0" height="76.5" as="geometry"/></mxCell><mxCell id="c67" value='Depois, U0 regista nas notas «o que combinámos»&lt;br&gt;&lt;font style="font-size:9px" color="#666666"&gt;UE18&lt;/font&gt;' style="whiteSpace=wrap;html=1;fontColor=#222222;spacingLeft=6;spacingRight=6;fontFamily=Arial;rounded=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;strokeColor=#6aa84f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="316.0" y="3951.8" width="300.0" height="45.3" as="geometry"/></mxCell><mxCell id="c68" value="O voo mais barato obriga a chegar ao aeroporto de madrugada, sem transporte (U0-06)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="657.0" y="910.9" width="325.0" height="29.7" as="geometry"/></mxCell><mxCell id="c69" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="640.0" y="911.9" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c70" value="Custo escondido que só aparece no pagamento: «isto ninguém diz» (U0-08)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="657.0" y="1631.8" width="325.0" height="29.7" as="geometry"/></mxCell><mxCell id="c71" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="640.0" y="1632.8" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c72" value="O grupo responde devagar e o preço sobe (U0-09)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="657.0" y="1910.4" width="251.7" height="14.8" as="geometry"/></mxCell><mxCell id="c73" value="" style="shape=image;html=1;verticalLabelPosition=bottom;imageAspect=0;aspect=fixed;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="640.0" y="1911.4" width="11.0" height="18.0" as="geometry"/></mxCell><mxCell id="c74" value="U0 adianta o dinheiro de todos (fecho: «e ter de adiantar eu o dinheiro»; U0-16)" style="text;html=1;fillColor=none;strokeColor=none;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="657.0" y="3126.