<mxfile host="drawio" type="device"><diagram name="SeqA0" id="SeqA0"><mxGraphModel dx="1000" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1798" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Sequence model: A0 (agente de viagens de balcão)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=20;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="18.0" width="956.0" height="24.0" as="geometry"/></mxCell><mxCell id="c2" value="Observámos o trabalho ao balcão (11h25–12h). A0 contou também um caso passado. Há 3 tarefas com triggers diferentes, logo 3 sequências, cada uma com o seu primary intent, mais o caso passado (AE07)." style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12.5;fontColor=#444444;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="48.0" width="956.0" height="30.0" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="89.0" width="44.0" height="18.0" as="geometry"/></mxCell><mxCell id="c4" value="Trigger" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="71.0" y="92.0" width="31.3" height="12.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116.3" y="90.0" width="34.0" height="16.0" as="geometry"/></mxCell><mxCell id="c6" value="Passo" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="155.3" y="92.0" width="27.8" height="12.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rhombus;fillColor=#fdeeb5;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="197.1" y="88.0" width="40.0" height="20.0" as="geometry"/></mxCell><mxCell id="c8" value="Decisão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="242.1" y="92.0" width="36.1" height="12.0" as="geometry"/></mxCell><mxCell id="c9" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="292.2" y="89.5" width="10.0" height="17.0" as="geometry"/></mxCell><mxCell id="c10" value="Breakdown" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="307.2" y="92.0" width="50.0" height="12.0" as="geometry"/></mxCell><mxCell id="c11" value="- - - &amp;gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="371.3" y="91.4" width="30.0" height="13.2" as="geometry"/></mxCell><mxCell id="c12" value="Loop" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=10;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="406.3" y="92.0" width="22.2" height="12.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;i&gt;Os códigos indicam a origem de cada elemento: UE / AE = registos da entrevista; U0- / A0- = notas da sessão de interpretação; fecho = resumo validado no fim da entrevista.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=9.5;fontColor=#555555;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="112.0" width="956.0" height="11.4" as="geometry"/></mxCell><mxCell id="c14" value="Sequência 1: Ver o que está pendente" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="137.4" width="956.0" height="16.8" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&quot;color:#2b4c7e&quot;&gt;Primary intent:&lt;/b&gt; Saber o que há para fazer" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="158.2" width="956.0" height="13.8" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Início do trabalho observado ao balcão, 11h25&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE01&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="198.0" width="270.0" height="67.4" as="geometry"/></mxCell><mxCell id="c17" value="Abre o sistema (algumas conversas pendentes) e a caixa de correio partilhada&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE01&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="291.4" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="184.0" width="976.0" height="178.8" as="geometry"/></mxCell><mxCell id="c19" value="Sequência 2: Responder a um pedido por email" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="376.8" width="956.0" height="16.8" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;color:#2b4c7e&quot;&gt;Primary intent:&lt;/b&gt; Responder ao pedido do cliente (não vimos A0 responder)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="397.6" width="956.0" height="13.8" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Pedido novo no correio&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE02&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="437.4" width="270.0" height="67.4" as="geometry"/></mxCell><mxCell id="c22" value="Lê: «vi opções de alojamento parecidas, por menos 10 ou 20 euros por noite». Suspira: «É isto, lá vamos nós.»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE02&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="530.8" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="546.2" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c24" value="Pressão sobre o preço: o cliente compara com opções mais baratas (AE02 [BD], A0-02)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="546.2" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="423.4" width="976.0" height="178.8" as="geometry"/></mxCell><mxCell id="c26" value="Sequência 3: Atender um casal ao balcão" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="616.1" width="956.0" height="16.8" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;color:#2b4c7e&quot;&gt;Primary intent:&lt;/b&gt; Dar ao casal uma viagem que funcione, sob a forma de proposta (interpretação nossa de AE03–AE06)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="636.9" width="956.0" height="13.8" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Entra um casal com um roteiro impresso: querem «algo deste género»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE03&lt;/span&gt;" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="676.7" width="270.0" height="81.2" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="662.7" width="976.0" height="109.2" as="geometry"/></mxCell><mxCell id="c30" value="Pergunta o orçamento, as datas flexíveis e «o que não abdicam»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE03&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="799.9" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="815.4" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c32" value="O roteiro não diz o orçamento, as datas flexíveis nem «o que não abdicam»: A0 tem de perguntar (A0-06)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="815.4" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c33" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Perceber o que o casal quer de facto&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#6b3fa0&quot;&gt;Secondary intent&lt;/span&gt;&lt;br&gt;&lt;i style=&quot;color:#6b3fa0;font-size:11px&quot;&gt;• Saber até onde o casal é flexível (A0-06)&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="799.9" width="293.0" height="72.0" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="785.9" width="976.0" height="100.0" as="geometry"/></mxCell><mxCell id="c35" value="Lê o roteiro: ideias, voos e sítios onde gostariam de ficar&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE03, AE04&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="913.9" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c36" value="O roteiro é viável?" style="rhombus;fillColor=#fdeeb5;strokeColor=#d4a72c;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=1;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="365.0" y="983.5" width="270.0" height="86.0" as="geometry"/></mxCell><mxCell id="c37" value="Mostra que duas cidades ficam a 6 h de comboio e que um monumento fecha no dia previsto&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE04&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1095.5" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c38" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1111.0" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c39" value="Logística inviável: A0 tem de desfazer o roteiro e passa por «desmancha-prazeres» (A0-05)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1111.0" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c40" value="O casal troca olhares, desagradado&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE04&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1178.9" width="320.0" height="43.6" as="geometry"/></mxCell><mxCell id="c41" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Evitar uma viagem que não funciona&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="913.9" width="293.0" height="28.8" as="geometry"/></mxCell><mxCell id="c42" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="899.9" width="976.0" height="336.6" as="geometry"/></mxCell><mxCell id="c43" value="Copia dados do portal para o modelo da agência (documento com logótipo)&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE05&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1264.5" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c44" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1280.0" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c45" value="Procurar e copiar dados à mão entre sistemas: «grande parte da manhã» (fecho, A0-07)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1280.0" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c46" value="Diz que envia a proposta por email «o mais rápido possível»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE05&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1347.8" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c47" value="O casal agradece e diz que vai «pensar e comparar online»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE06&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1431.2" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c48" value="&lt;span style=&quot;font-size:9.5px;font-weight:bold;color:#2b4c7e&quot;&gt;Intent&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Enviar a proposta ao casal «o mais rápido possível»&lt;/span&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="24.0" y="1264.5" width="293.0" height="28.8" as="geometry"/></mxCell><mxCell id="c49" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1250.5" width="976.0" height="252.2" as="geometry"/></mxCell><mxCell id="c50" value="Caso passado (AE07): a taxa de serviço" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=14;fontColor=#222222;fontStyle=1;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="1516.6" width="956.0" height="16.8" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b style=&quot;color:#2b4c7e&quot;&gt;Primary intent:&lt;/b&gt; Cobrar a taxa de serviço (A0-03)&lt;br&gt;&lt;i&gt;A0 contou este caso durante a observação. Não o vimos acontecer.&lt;/i&gt;" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="1537.4" width="956.0" height="27.6" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;Não registado: AE07 só diz que o cliente recusou" style="ellipse;fillColor=#d4e3f8;gradientColor=#7fa5df;gradientDirection=south;strokeColor=#5b7fb8;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="1591.0" width="270.0" height="67.4" as="geometry"/></mxCell><mxCell id="c53" value="O cliente recusa pagar a taxa de serviço «porque o site não cobra»&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#777777&quot;&gt;AE07&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;fillColor=#e2f2d8;gradientColor=#a5d48a;gradientDirection=south;strokeColor=#6aa84f;strokeWidth=1;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11.5;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="340.0" y="1684.4" width="320.0" height="57.4" as="geometry"/></mxCell><mxCell id="c54" value="" style="shape=image;html=1;imageAspect=0;image=data:image/svg+xml,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMiAyMCI+PHBhdGggZD0iTTcgMCBMMSAxMSBMNS41IDExIEwzLjUgMjAgTDExIDcgTDYuNSA3IEw5IDAgWiIgZmlsbD0iI2YwN2ExYSIgc3Ryb2tlPSIjYzAzOTBiIiBzdHJva2Utd2lkdGg9IjAuOCIvPjwvc3ZnPg==;" vertex="1" parent="1"><mxGeometry x="682.0" y="1699.9" width="11.0" height="19.0" as="geometry"/></mxCell><mxCell id="c55" value="O cliente recusa a taxa porque o site não a cobra; A0 acaba por perder o cliente (A0-03)" style="rounded=0;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=11;fontColor=#9a3200;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="699.0" y="1699.9" width="283.0" height="26.4" as="geometry"/></mxCell><mxCell id="c56" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#f2f5fa;strokeColor=none;html=1;whiteSpace=wrap;overflow=visible;fontFamily=Arial;fontSize=12;fontColor=#222222;fontStyle=0;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="12.0" y="1577.0" width="976.0" height="178.8" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;strokeWidth=1;fontSize=10;fontFamily=Arial;labelBackgroundColor=none;align=left;verticalAlign=top;spacingLeft=4;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=block;endFill=1;endSize=5;html=1;rounded=0;strokeColor=#222222;strokeWidth=1;fontSize=10;fontFa