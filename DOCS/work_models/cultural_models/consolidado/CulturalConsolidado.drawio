        <mxCell id="k31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=center;" value="«Pareço certo, mesmo&lt;br&gt;quando não estou» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE10; A0: fecho)&lt;/font&gt;&lt;br&gt;«Aqui tens um roteiro barato»&lt;br&gt;&lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE10, só viajantes)&lt;/font&gt;" vertex="1"><mxGeometry x="655" y="145" width="195" height="64" as="geometry" /></mxCell>
