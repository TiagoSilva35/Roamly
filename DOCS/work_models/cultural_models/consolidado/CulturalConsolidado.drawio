        <mxCell id="k18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="«Cracóvia por 150 €;&lt;br&gt;prova isto» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE01, UE11)&lt;/font&gt;" vertex="1"><mxGeometry x="40" y="158" width="190" height="36" as="geometry" /></mxCell>
        <mxCell id="k19" edge="1" parent="1" style="html=1;rounded=0;strokeWidth=2;strokeColor=#4B5563;endArrow=block;endFill=1;endSize=8;startArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="260" as="sourcePoint" /><mxPoint x="320" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="k20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="«Não gastes o que não tens;&lt;br&gt;diz-me onde vais dormir» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE13)&lt;/font&gt;" vertex="1"><mxGeometry x="40" y="290" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="k21" edge="1" parent="1" style="html=1;rounded=0;strokeWidth=2;strokeColor=#4B5563;endArrow=block;endFill=1;endSize=8;startArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="600" as="sourcePoint" /><mxPoint x="420" y="425" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="k22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="«Pagámos 360 € pelo mesmo»&lt;br&gt;(orgulho) &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE19)&lt;/font&gt;" vertex="1"><mxGeometry x="300" y="665" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="k23" edge="1" parent="1" style="html=1;rounded=0;strokeWidth=2;strokeColor=#4B5563;endArrow=block;endFill=1;endSize=8;startArrow=none;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="415" as="sourcePoint" /><mxPoint x="335" y="385" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="k24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="«Só vamos se for barato e perto&lt;br&gt;do fim de semana» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE02, UE09)&lt;/font&gt;&lt;br&gt;«Dormitório não» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE05)&lt;/font&gt;&lt;br&gt;«Respondemos quando calhar» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE08)&lt;/font&gt;&lt;br&gt;«Não abrimos a folha: manda print» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE17)&lt;/font&gt;" vertex="1"><mxGeometry x="30" y="505" width="260" height="80" as="geometry" /></mxCell>
