        <mxCell id="k28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="«Decidam e paguem&lt;br&gt;a vossa parte» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE08, UE16)&lt;/font&gt;" vertex="1"><mxGeometry x="40" y="635" width="180" height="40" as="geometry" /></mxCell>
