  <diagram name="Cultural consolidado" id="cult-cons">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1500" pageHeight="1140" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="k2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="&lt;b style=&quot;font-size:16px&quot;&gt;Modelo cultural consolidado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;Influências sobre viajantes e agentes de balcão, a partir dos modelos culturais de U0 e A0&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="12" width="900" height="44" as="geometry" /></mxCell>
        <mxCell id="k3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;dashPattern=8 4;fillOpacity=80;verticalAlign=top;spacingTop=22;fontSize=12;fontFamily=Helvetica;fontColor=#1F2937;" value="&lt;b&gt;Cultura de viajar barato&lt;/b&gt;&lt;br&gt;viajante esperto, não turista&lt;br&gt;&lt;br&gt;&lt;i&gt;«Viajar bem é gastar pouco;&lt;br&gt;o que é para turistas não conta»&lt;/i&gt; &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE12, UE19)&lt;/font&gt;" vertex="1"><mxGeometry x="260" y="75" width="360" height="235" as="geometry" /></mxCell>
        <mxCell id="k4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;dashPattern=8 4;fillOpacity=80;verticalAlign=top;spacingTop=22;fontSize=12;fontFamily=Helvetica;fontColor=#1F2937;" value="&lt;b&gt;Identidade do agente de balcão&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;«Somos quem aconselha, resolve&lt;br&gt;e conhece os fornecedores»&lt;/i&gt; &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(A0-11)&lt;/font&gt;" vertex="1"><mxGeometry x="900" y="75" width="360" height="235" as="geometry" /></mxCell>
