        <mxCell id="k26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="«Pagamos quando der» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE16)&lt;/font&gt;" vertex="1"><mxGeometry x="51" y="591" width="180" height="34" as="geometry" /></mxCell>
