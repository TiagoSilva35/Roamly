        <mxCell id="k35" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=center;" value="«Já vimos mais barato online: justifica o teu preço» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(AE02)&lt;/font&gt;&lt;br&gt;«Trazemos a viagem pensada; faz algo deste género» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(AE03)&lt;/font&gt;&lt;br&gt;«Aconselha-nos; decidimos depois, online» &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(AE06)&lt;/font&gt;" vertex="1"><mxGeometry x="625" y="255" width="300" height="70" as="geometry" /></mxCell>
