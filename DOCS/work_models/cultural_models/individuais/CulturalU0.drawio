        <mxCell id="k2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#374151;align=left;" value="&lt;b style=&quot;font-size:16px&quot;&gt;Modelo cultural · U0&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6B7280&quot;&gt;Organizador(a) de uma viagem de grupo com limite de 300 € por pessoa: quem influencia e como o sente&lt;/span&gt;" vertex="1"><mxGeometry x="40" y="12" width="800" height="44" as="geometry" /></mxCell>
        <mxCell id="k3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;dashPattern=8 4;fillOpacity=80;verticalAlign=top;spacingTop=22;fontSize=12;fontFamily=Helvetica;fontColor=#1F2937;" value="&lt;b&gt;Cultura de viajar barato&lt;/b&gt;&lt;br&gt;viajante esperto, não turista&lt;br&gt;&lt;br&gt;&lt;i&gt;«Viajar bem é gastar pouco;&lt;br&gt;o que é para turistas não conta»&lt;/i&gt; &lt;font color=&quot;#8A8A8A&quot; style=&quot;font-size:9px&quot;&gt;(UE12, UE19)&lt;/font&gt;" vertex="1"><mxGeometry x="370" y="115" width="360" height="255" as="geometry" /></mxCell>
