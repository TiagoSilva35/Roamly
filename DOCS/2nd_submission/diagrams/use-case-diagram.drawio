<mxfile host="app.diagrams.net"><diagram name="Diagrama de casos de uso (L1)" id="ucd"><mxGraphModel dx="1960" dy="964" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1960" pageHeight="964" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="&lt;b&gt;Roamly&lt;/b&gt; (Release 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1580" height="574" as="geometry"/></mxCell><mxCell id="save" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Guardar uma ideia de viagem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="240" width="200" height="104" as="geometry"/></mxCell><mxCell id="uc01" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;UC-01 Definir os limites da viagem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="240" width="200" height="104" as="geometry"/></mxCell><mxCell id="add" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Adicionar uma oferta por ligação" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="240" width="200" height="104" as="geometry"/></mxCell><mxCell id="uc02" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;UC-02 Saber o total real por pessoa&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pontos de extensão:&lt;br&gt;corte de um item&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="240" width="200" height="104" as="geometry"/></mxCell><mxCell id="plan" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Planear atividades dentro do orçamento" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="240" width="200" height="104" as="geometry"/></mxCell><mxCell id="collect" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Recolher a parte de cada um" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="240" width="200" height="104" as="geometry"/></mxCell><mxCell id="uc04" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;UC-04 Levar o grupo a decidir sobre a proposta&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pontos de extensão:&lt;br&gt;subida de preço&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="240" width="200" height="104" as="geometry"/></mxCell><mxCell id="summ" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«resumo»&lt;/font&gt;&lt;br&gt;Organizar uma viagem de grupo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FDF1DC;strokeColor=#B7791F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="50" width="200" height="104" as="geometry"/></mxCell><mxCell id="cut" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Cortar um item" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="450" width="200" height="104" as="geometry"/></mxCell><mxCell id="calc" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«subfunção»&lt;/font&gt;&lt;br&gt;Calcular o total por pessoa" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1230" y="450" width="200" height="104" as="geometry"/></mxCell><mxCell id="alert" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«subfunção»&lt;/font&gt;&lt;br&gt;Alertar subida de preço" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="450" width="200" height="104" as="geometry"/></mxCell><mxCell id="org" value="Organizador(a) do grupo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;ator principal&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="72.0" width="30" height="60" as="geometry"/></mxCell><mxCell id="member" value="Membro do grupo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;ator secundário&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1830" y="250" width="30" height="60" as="geometry"/></mxCell><mxCell id="sites" value="&lt;font style=&quot;font-size:10px&quot;&gt;«sistema»&lt;/font&gt;&lt;br&gt;Sites dos fornecedores&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;ator secundário&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="530.0" y="722.0" width="170" height="64" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="summ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="member" target="uc04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=open;endSize=10;endFill=0;html=1;rounded=0;" edge="1" parent="1" source="add" target="sites"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=open;endSize=10;endFill=0;html=1;rounded=0;" edge="1" parent="1" source="alert" target="sites"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc02" target="calc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="plan" target="calc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="collect" target="calc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc04" target="calc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="«extend»&amp;#10;(corte de um item)" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cut" target="uc02"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="«extend»&amp;#10;(subida de preço)" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alert" target="uc04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="summ" target="save"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="185"/><mxPoint x="330.0" y="185"/></Array></mxGeometry></mxCell><mxCell id="e12" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="summ" target="uc01"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="185"/><mxPoint x="550.0" y="185"/></Array></mxGeometry></mxCell><mxCell id="e13" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="summ" target="add"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="185"/><mxPoint x="770.0" y="185"/></Array></mxGeometry></mxCell><mxCell id="e14" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="summ" target="uc02"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="185"/><mxPoint x="990.0" y="185"/></Array></mxGeometry></mxCell><mxCell id="e15" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="summ" target="plan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="185"/><mxPoint x="1210.0" y="185"/></Array></mxGeometry></mxCell><mxCell id="e16" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="summ" target="collect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="185"/><mxPoint x="1430.0" y="185"/></Array></mxGeometry></mxCell><mxCell id="e17" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="summ" target="uc04"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990.0" y="185"/><mxPoint x="1650.0" y="185"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Níveis (Cockburn): resumo em cima; objetivos do utilizador ao nível do mar (linha pontilhada); subfunções em baixo.&lt;br&gt;Cores: laranja = resumo · verde = objetivo do utilizador · cinzento = subfunção.&lt;br&gt;Ator principal: tem o objetivo e inicia o caso de uso (à esquerda).&lt;br&gt;Ator secundário: o Roamly precisa dele para cumprir o objetivo (à direita / em baixo).&lt;br&gt;Linha contínua: o ator participa no caso de uso.&lt;br&gt;«sistema»: ator que é um sistema externo, não uma pessoa.&lt;br&gt;Seta contínua para um «sistema»: o Roamly contacta-o (pede a oferta ou o preço); ele só responde.&lt;br&gt;«include» (tracejado): o caso base usa sempre o caso incluído; a seta aponta para o incluído.&lt;br&gt;«extend» (tracejado): comportamento opcional; a seta aponta para o caso base, no ponto de extensão indicado." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;strokeColor=#9CA3AF;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="784" width="600" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>