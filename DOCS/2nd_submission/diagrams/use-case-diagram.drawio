<mxfile host="app.diagrams.net"><diagram name="Diagrama de casos de uso (L1)" id="ucd"><mxGraphModel dx="1400.0" dy="1217" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1400.0" pageHeight="1217" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="&lt;b&gt;Roamly&lt;/b&gt; (Release 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="20" width="710" height="996" as="geometry"/></mxCell><mxCell id="save" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Guardar uma ideia de viagem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="200" height="96" as="geometry"/></mxCell><mxCell id="uc01" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;UC-01 Definir os limites da viagem" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="205" width="200" height="96" as="geometry"/></mxCell><mxCell id="add" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Adicionar uma oferta por ligação" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="340" width="200" height="96" as="geometry"/></mxCell><mxCell id="uc02" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;UC-02 Saber o total real por pessoa&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pontos de extensão:&lt;br&gt;corte de um item&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="475" width="200" height="96" as="geometry"/></mxCell><mxCell id="plan" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Planear atividades dentro do orçamento" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="610" width="200" height="96" as="geometry"/></mxCell><mxCell id="collect" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Recolher a parte de cada um" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="745" width="200" height="96" as="geometry"/></mxCell><mxCell id="uc04" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;UC-04 Levar o grupo a decidir sobre a proposta&lt;hr size=&quot;1&quot;&gt;&lt;font style=&quot;font-size:9px&quot;&gt;pontos de extensão:&lt;br&gt;subida de preço&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="880" width="200" height="96" as="geometry"/></mxCell><mxCell id="cut" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«objetivo do utilizador»&lt;/font&gt;&lt;br&gt;Cortar um item" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCEFEE;strokeColor=#0E6E68;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="315" width="200" height="96" as="geometry"/></mxCell><mxCell id="calc" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«subfunção»&lt;/font&gt;&lt;br&gt;Calcular o total por pessoa" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="520" width="200" height="96" as="geometry"/></mxCell><mxCell id="alert" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#6B7280&quot;&gt;«subfunção»&lt;/font&gt;&lt;br&gt;Alertar subida de preço" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="795" width="200" height="96" as="geometry"/></mxCell><mxCell id="org" value="Organizador(a) do grupo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;ator principal&lt;/font&gt;" style="shape=umlActor;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="550" width="30" height="60" as="geometry"/></mxCell><mxCell id="member" value="Membro do grupo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;ator secundário&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="880" width="30" height="60" as="geometry"/></mxCell><mxCell id="sites" value="&lt;font style=&quot;font-size:10px&quot;&gt;«sistema»&lt;/font&gt;&lt;br&gt;Sites dos fornecedores&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#6B7280&quot;&gt;ator secundário&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1190.0" y="188.0" width="170" height="64" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="uc01"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="add"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="uc02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="collect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="org" target="uc04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=none;html=1;rounded=0;" edge="1" parent="1" source="member" target="uc04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="endArrow=open;endSize=10;endFill=0;html=1;rounded=0;" edge="1" parent="1" source="add" target="sites"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=open;endSize=10;endFill=0;html=1;rounded=0;" edge="1" parent="1" source="alert" target="sites"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc02" target="calc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="plan" target="calc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="collect" target="calc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc04" target="calc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="«extend»&amp;#10;(corte de um item)" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cut" target="uc02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="«extend»&amp;#10;(subida de preço)" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alert" target="uc04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;Verde: objetivo do utilizador · Cinzento: subfunção (níveis de Cockburn).&lt;br&gt;Ator principal: tem o objetivo e inicia o caso de uso (à esquerda).&lt;br&gt;Ator secundário: o Roamly precisa dele para cumprir o objetivo (à direita).&lt;br&gt;Linha contínua: o ator participa no caso de uso.&lt;br&gt;«sistema»: ator que é um sistema externo, não uma pessoa.&lt;br&gt;Seta contínua para um «sistema»: o Roamly contacta-o (pede a oferta ou o preço); ele só responde.&lt;br&gt;«include» (tracejado): o caso base usa sempre o caso incluído; a seta aponta para o incluído.&lt;br&gt;«extend» (tracejado): comportamento opcional; a seta aponta para o caso base,&lt;br&gt;no ponto de extensão indicado." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;strokeColor=#9CA3AF;spacing=6;" vertex="1" parent="1"><mxGeometry x="820.0" y="1041" width="560" height="156" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>